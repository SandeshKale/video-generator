{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 3.308,
   "text": "Pandrah din. Dedh hazaar crore se upar ki kamaai, andaaze se.",
   "cap": ""
  },
  {
   "id": "s2",
   "group": "g1",
   "start": 3.068,
   "end": 6.428,
   "text": "Par is film ko banane wali company par? Paanch hazaar crore ka karz.",
   "cap": ""
  },
  {
   "id": "s3",
   "group": "g2",
   "start": 7.085,
   "end": 11.492,
   "text": "Ye kahani shuru hui thi unnees sau pachaanbe mein. Ek garage, ek bank loan, aur bas ek bharosa.",
   "cap": ""
  },
  {
   "id": "s4",
   "group": "g3",
   "start": 12.044,
   "end": 20.089,
   "text": "Aur aaj? Sabse bada kharcha, log. Tankhwah mein kareeb 2,885 crore, byaaj mein 558 crore. Aur poori kamaai? 3,950 crore.",
   "cap": ""
  },
  {
   "id": "s5",
   "group": "g4",
   "start": 20.986,
   "end": 24.213,
   "text": "Toh sawaal seedha hai. Itna bada galla, kya is karz ke liye kaafi hai?",
   "cap": ""
  }
 ],
