{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 4.641,
   "text": "Breaking news: billionaires bore ho rahe hain. Solution? Aapka bijli ka bill, dating app ki tarah, right swipe.",
   "cap": "Breaking news: billionaires bore ho rahe hain. Solution? Aapka bijli ka bill, dating app ki tarah, right swipe."
  },
  {
   "id": "p1",
   "group": "g2",
   "start": 5.709,
   "end": 8.772,
   "text": "Idea simple hai: bill upload karo, billionaire swipe right kare, bill pay.",
   "cap": "Idea simple hai: bill upload karo, billionaire swipe right kare, bill pay."
  },
  {
   "id": "r1",
   "group": "g2",
   "start": 8.632,
   "end": 11.212,
   "text": "Ek chhoti si dikkat: yeh Elon Musk ne tweet kiya hi nahi.",
   "cap": "Ek chhoti si dikkat: yeh Elon Musk ne tweet kiya hi nahi."
  },
  {
   "id": "r2",
   "group": "g3",
   "start": 11.811,
   "end": 16.891,
   "text": "Lead Stories ne unke account par bored billionaires search kiya: zero results. Idea ek aam X user ka tha.",
   "cap": "Lead Stories ne unke account par bored billionaires search kiya: zero results. Idea ek aam X user ka tha."
  },
  {
   "id": "t1",
   "group": "g4",
   "start": 17.767,
   "end": 24.908,
   "text": "Technology. Bill asli hai? App bill padhta hai, biller se match karta hai, insaan se check karwata hai. Pay My Billionaires paisa seedha biller ko deta hai; Venmo ke links bahar.",
   "cap": "Technology. Bill asli hai? App bill padhta hai, biller se match karta hai, insaan se check karwata hai. Pay My Billionaires paisa seedha biller ko deta hai; Venmo ke links bahar."
  },
  {
   "id": "t2",
   "group": "g5",
   "start": 25.569,
   "end": 33.589,
   "text": "Do billionaire ek hi bill par swipe karein to double payment, isliye ek bill, ek hold. Aur bill par naam, pata, account number: public deck matlab ghar ka address Instagram par.",
   "cap": "Do billionaire ek hi bill par swipe karein to double payment, isliye ek bill, ek hold. Aur bill par naam, pata, account number: public deck matlab ghar ka address Instagram par."
  },
  {
   "id": "t3",
   "group": "g6",
   "start": 34.178,
   "end": 42.439,
   "text": "Forbes: teen hazaar chaar sau athaais billionaire. Amrika me chaudah million logon par hazaar dollar se upar ka medical karz. Matlab har billionaire ke hisse lagbhag chaar hazaar bill.",
   "cap": "Forbes: teen hazaar chaar sau athaais billionaire. Amrika me chaudah million logon par hazaar dollar se upar ka medical karz. Matlab har billionaire ke hisse lagbhag chaar hazaar bill."
  },
  {
   "id": "f1",
   "group": "g7",
   "start": 43.077,
   "end": 47.3,
   "text": "Ab paisa. UK ke OnlyBills me supporter ek se dus pound flat, phir dus percent fee deta hai.",
   "cap": "Ab paisa. UK ke OnlyBills me supporter ek se dus pound flat, phir dus percent fee deta hai."
  },
  {
   "id": "f1b",
   "group": "g7b",
   "start": 47.823,
   "end": 54.433,
   "text": "India me non-relative se saal me pachaas hazaar se upar ka gift, lene waale par tax, meri samajh se; CA se poochna. Billionaire ka daan, aapki tax slip.",
   "cap": "India me non-relative se saal me pachaas hazaar se upar ka gift, lene waale par tax, meri samajh se; CA se poochna. Billionaire ka daan, aapki tax slip."
  },
  {
   "id": "f2",
   "group": "g8",
   "start": 54.94,
   "end": 63.348,
   "text": "Ek pyara hisaab: Forbes ke number me sabse upar ka aadmi lagbhag aath sau untaalis billion dollar; pandrah sau dollar ka rent uske liye utna, jitna crorepati ke liye do paise.",
   "cap": "Ek pyara hisaab: Forbes ke number me sabse upar ka aadmi lagbhag aath sau untaalis billion dollar; pandrah sau dollar ka rent uske liye utna, jitna crorepati ke liye do paise."
  },
  {
   "id": "f3",
   "group": "g9",
   "start": 64.0,
   "end": 69.623,
   "text": "Aur poore Amrika ka medical karz, billionaires ki daulat ka lagbhag ek percent. Paisa kam nahi, plumbing kam hai.",
   "cap": "Aur poore Amrika ka medical karz, billionaires ki daulat ka lagbhag ek percent. Paisa kam nahi, plumbing kam hai."
  },
  {
   "id": "m1",
   "group": "g10",
   "start": 70.143,
   "end": 77.037,
   "text": "Naitikta. Is app me aapka bill aapki dating profile hai, aur swipe left matlab kisi ka kiraya next. Kiraya bharega ya nahi, billionaire ke mood par.",
   "cap": "Naitikta. Is app me aapka bill aapki dating profile hai, aur swipe left matlab kisi ka kiraya next. Kiraya bharega ya nahi, billionaire ke mood par."
  },
  {
