{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 4.317,
   "text": "भारत का अपना GPS आपकी जगह बता सकता है, पर एक शर्त पर: चार satellite चाहिए।",
   "cap": "Bharat ka apna GPS aapki jagah bata sakta hai, par ek shart par: chaar satellite chahiye."
  },
  {
   "id": "h2",
   "group": "g1",
   "start": 4.077,
   "end": 5.857,
   "text": "और इस वक़्त, उसके पास सिर्फ़ तीन हैं।",
   "cap": "Aur is waqt, uske paas sirf teen hain."
  },
  {
   "id": "h3",
   "group": "g2",
   "start": 6.395,
   "end": 8.077,
   "text": "चार क्यों? और बाक़ी गए कहाँ?",
   "cap": "Chaar kyon? Aur baaki gaye kahaan?"
  },
  {
   "id": "p1",
   "group": "g2",
   "start": 7.657,
   "end": 12.117,
   "text": "NavIC, भारत का अपना navigation system, ताकि हमें किसी और देश के सिग्नल पर, निर्भर न रहना पड़े।",
   "cap": "NavIC, Bharat ka apna navigation system, taaki hamein kisi aur desh ke signal par, nirbhar na rehna pade."
  },
  {
   "id": "p3",
   "group": "g3",
   "start": 13.139,
   "end": 19.642,
   "text": "30 अक्टूबर की रात, ISRO ने एक और satellite भेजा। उसमें एक चीज़ भारत ने पहली बार अपने हाथ से बनाई। पर वो अभी क्या नहीं कर सकता, ये आख़िर में।",
   "cap": "30 October ki raat, ISRO ne ek aur satellite bheja. Usmein ek cheez Bharat ne pehli baar apne haath se banayi. Par wo abhi kya nahi kar sakta, ye aakhir mein."
  },
  {
   "id": "i1",
   "group": "g3",
   "start": 19.502,
   "end": 20.882,
   "text": "पहले समझो, चार क्यों।",
   "cap": "Chalo pehle samjhein, chaar kyon."
  },
  {
   "id": "i2",
   "group": "g4",
   "start": 21.758,
   "end": 25.021,
   "text": "Satellite आपको जगह नहीं बताता। वो सिर्फ़ समय बताता है: इस पल भेजा।",
   "cap": "Satellite aapko jagah nahi batata. Wo sirf samay batata hai, is pal bheja."
  },
  {
   "id": "i3",
   "group": "g5",
   "start": 25.803,
   "end": 30.969,
   "text": "आपका फ़ोन देखता है, सिग्नल आने में कितना वक़्त लगा। और रोशनी एक नैनोसेकंड में, सिर्फ़ तीस सेंटीमीटर चलती है।",
   "cap": "Aapka phone dekhta hai, signal aane mein kitna waqt laga. Aur roshni ek nanosecond mein, sirf tees centimetre chalti hai."
  },
  {
   "id": "i5",
   "group": "g5",
   "start": 30.629,
   "end": 34.669,
   "text": "यानी घड़ी में एक माइक्रोसेकंड की गड़बड़, और आपका फ़ोन आपको तीन सौ मीटर दूर बता देगा।",
   "cap": "Yaani ghadi mein ek microsecond ki gadbad, aur aapka phone aapko teen sau metre door bata dega."
  },
  {
   "id": "i6",
   "group": "g6",
   "start": 35.643,
   "end": 42.21,
   "text": "तीन satellite से जगह निकल जाती, अगर आपके फ़ोन की घड़ी बिलकुल सही होती। वो नहीं है। इसलिए चौथा satellite, सिर्फ़ आपके फ़ोन की घड़ी ठीक करता है।",
   "cap": "Teen satellite se jagah nikal jaati, agar aapke phone ki ghadi bilkul sahi hoti. Wo nahi hai. Isliye chautha satellite, sirf aapke phone ki ghadi theek karta hai."
  },
  {
   "id": "b1",
   "group": "g7",
   "start": 43.169,
   "end": 45.434,
   "text": "अब सोचो, अगर satellite की अपनी घड़ी ही बिगड़ जाए?",
   "cap": "Ab socho, agar satellite ki apni ghadi hi bigad jaaye?"
  },
  {
   "id": "b2",
   "group": "g7",
   "start": 45.234,
   "end": 51.034,
   "text": "यही हुआ। 2016 से शुरू होकर, पहले NavIC satellite की तीनों atomic clock बंद हो गईं। ये घड़ियाँ विदेश से मँगाई गई थीं।",
   "cap": "Yahi hua. 2016 se shuru hokar, pehle NavIC satellite ki teeno atomic clock band ho gayeen. Ye ghadiyaan videsh se mangayi gayi thi."
  },
  {
   "id": "b3",
   "group": "g8",
   "start": 51.913,
   "end": 56.302,
   "text": "तो एक और satellite भेजा गया। पर अगस्त 2017 में, वो रॉकेट से अलग ही नहीं हुआ।",
   "cap": "To ek aur satellite bheja gaya. Par August 2017 mein, wo rocket se alag hi nahi hua."
  },
  {
   "id": "b4",
   "group": "g8",
   "start": 55.862,
   "end": 61.042,
   "text": "फिर 2025 में NVS-02 गया, पर इंजन का वाल्व ख़राब हुआ, और वो सही orbit तक पहुँचा ही नहीं।",
   "cap": "Phir 2025 mein NVS-02 gaya, par engine ka valve kharab hua, aur wo sahi orbit tak pahuncha hi nahi."
  },
  {
   "id": "d1",
   "group": "g9",
   "start": 61.94,
   "end": 69.286,
   "text": "और 13 मार्च 2026 को, IRNSS-1F की घड़ी भी रुक गई। ISRO ने ख़ुद लिखा: procured atomic clock stopped functioning।",
   "cap": "Aur 13 March 2026 ko, IRNSS-1F ki ghadi bhi ruk gayi. ISRO ne khud likha: kharidi hui atomic clock ne kaam karna band kar diya."
  },
  {
   "id": "d2",
   "group": "g9",
   "start": 68.866,
   "end": 73.066,
   "text": "संसद में सरकार ने कहा: कम से कम चार चाहिए। और ठीक से navigation देने वाले, सिर्फ़ तीन बचे।",
   "cap": "Sansad mein sarkar ne kaha: kam se kam chaar chahiye. Aur theek se navigation dene wale, sirf teen bache."
  },
  {
   "id": "d3",
   "group": "g10",
   "start": 73.916,
   "end": 79.092,
   "text": "ध्यान रहे: आपके फ़ोन का नक़्शा चलता रहा, क्योंकि फ़ोन कई सिस्टम साथ इस्तेमाल करता है। रुका, NavIC का अकेले खड़े होना।",
   "cap": "Dhyaan rahe: aapke phone ka naqsha chalta raha, kyonki phone kai system saath istemaal karta hai. Ruka, NavIC ka akele khade hona."
  },
  {
   "id": "t1",
   "group": "g10",
   "start": 78.892,
   "end": 81.952,
   "text": "तो भारत ने वही किया, जो पहले नहीं किया था: अपनी घड़ी ख़ुद बनाई।",
   "cap": "To Bharat ne wahi kiya, jo pehle nahi kiya tha: apni ghadi khud banayi."
  },
  {
   "id": "t2",
   "group": "g11",
   "start": 82.904,
   "end": 87.711,
   "text": "अहमदाबाद में बनी देसी rubidium atomic clock, पहली बार 2023 में NVS-01 पर उड़ी।",
   "cap": "Ahmedabad mein bani desi rubidium atomic clock, pehli baar 2023 mein NVS-01 par udi."
  },
  {
   "id": "t3",
   "group": "g11",
   "start": 87.511,
   "end": 93.491,
   "text": "30 अक्टूबर की रात, GSLV-F18 ने NVS-03 को उड़ाया। उसमें वही देसी घड़ी है, और एक नया L1 signal।",
   "cap": "30 October ki raat, GSLV-F18 ne NVS-03 ko udaya. Usmein wahi desi ghadi hai, aur ek naya L1 signal."
  },
  {
   "id": "y1",
   "group": "g12",
   "start": 94.467,
   "end": 99.796,
   "text": "अब गिनती। तीन चालू, और NVS-03 अपनी जगह पहुँचा, तो चार। यानी NavIC फिर से, अकेले आपकी जगह बता पाएगा।",
   "cap": "Ab ginti. Teen chaalu, aur NVS-03 apni jagah pahuncha, to chaar. Yaani NavIC phir se, akele aapki jagah bata paayega."
  },
  {
   "id": "y3",
   "group": "g13",
   "start": 100.657,
   "end": 105.318,
   "text": "पर अभी नहीं। NVS-03 अभी transfer orbit में है। उसे अपनी जगह तक पहुँचना है, और चालू होना है।",
   "cap": "Par abhi nahi. NVS-03 abhi transfer orbit mein hai. Use apni jagah tak pahunchna hai, aur chaalu hona hai."
  },
  {
   "id": "y4",
   "group": "g13b",
   "start": 105.945,
   "end": 109.962,
   "text": "जिस देश ने सिग्नल अपना बनाया, उसकी असली निर्भरता घड़ी में थी। और चौथी घड़ी, अब अपनी है।",
   "cap": "Jis desh ne signal apna banaya, uski asli nirbharta ghadi mein thi. Aur chauthi ghadi, ab apni hai."
  },
  {
   "id": "c1",
   "group": "g14",
   "start": 110.982,
   "end": 114.367,
   "text": "कोई कहे भारत के पास अपनी technology नहीं, तो उसे ये भेजिए।",
   "cap": "Koi kahe Bharat ke paas apni technology nahi, to use ye bhejiye."
  },
  {
   "id": "c2",
   "group": "g14",
   "start": 114.007,
   "end": 116.307,
   "text": "Sandesh Explains को, like, share और subscribe करना।",
   "cap": "Sandesh Explains ko, like, share aur subscribe karna."
  }
 ],
