{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 5.927,
   "text": "Is game ke puddle mein ek building dikh rahi hai jo screen par hai hi nahi. Yeh kaise mumkin hai? Jawab ek ulti soch mein hai: roshni ko ulta chalana.",
   "cap": "Is game ke puddle mein ek building dikh rahi hai jo screen par hai hi nahi. Yeh kaise mumkin hai? Jawab ek ulti soch mein hai: roshni ko ulta chalana."
  },
  {
   "id": "p1",
   "group": "g2",
   "start": 6.998,
   "end": 12.481,
   "text": "Asli duniya mein ek bulb se roshni ki arbon kirnein nikalti hain. Zyadatar deewaron mein kho jaati hain. Bahut kam hi aankh tak pahunchti hain.",
   "cap": "Asli duniya mein ek bulb se roshni ki arbon kirnein nikalti hain. Zyadatar deewaron mein kho jaati hain. Bahut kam hi aankh tak pahunchti hain."
  },
  {
   "id": "p2",
   "group": "g2",
   "start": 12.301,
   "end": 15.841,
   "text": "Computer ke liye yeh bada nuksaan hai: arbon kirnein banao, aur kaam ki sirf chand.",
   "cap": "Computer ke liye yeh bada nuksaan hai: arbon kirnein banao, aur kaam ki sirf chand."
  },
  {
   "id": "r1",
   "group": "g3",
   "start": 16.854,
   "end": 21.731,
   "text": "Ray tracing ulta karta hai. Aankh se, har pixel se, ek kiran bahar ki taraf bhejo. Ise primary ray kehte hain.",
   "cap": "Ray tracing ulta karta hai. Aankh se, har pixel se, ek kiran bahar ki taraf bhejo. Ise primary ray kehte hain."
  },
  {
   "id": "r2",
   "group": "g3",
   "start": 21.591,
   "end": 25.431,
   "text": "Kiran kisi cheez se takrati hai aur ek hi sawaal puchti hai: tum kya ho, aur tumhara rang kya hai?",
   "cap": "Kiran kisi cheez se takrati hai aur ek hi sawaal puchti hai: tum kya ho, aur tumhara rang kya hai?"
  },
  {
   "id": "b1",
   "group": "g4",
   "start": 26.37,
   "end": 33.075,
   "text": "Agar cheez sheeshe jaisi hai to kiran uchhal kar doosri kiran banti hai. Wahi kiran peeche khadi building tak jaati hai, isliye puddle mein woh dikhti hai, chahe screen par na ho.",
   "cap": "Agar cheez sheeshe jaisi hai to kiran uchhal kar doosri kiran banti hai. Wahi kiran peeche khadi building tak jaati hai, isliye puddle mein woh dikhti hai, chahe screen par na ho."
  },
  {
   "id": "s1",
   "group": "g5",
   "start": 33.94,
   "end": 38.17,
   "text": "Phir ek kiran roshni ki taraf jaati hai. Raaste mein kuch aaya to chhaya, nahi aaya to roshni. Shadow bhi ek sawaal hai.",
   "cap": "Phir ek kiran roshni ki taraf jaati hai. Raaste mein kuch aaya to chhaya, nahi aaya to roshni. Shadow bhi ek sawaal hai."
  },
  {
   "id": "v1",
   "group": "g6",
   "start": 39.007,
   "end": 43.237,
   "text": "Par scene mein karodon triangles hote hain. Har kiran sab check kare to ek frame bhi na bane.",
   "cap": "Par scene mein karodon triangles hote hain. Har kiran sab check kare to ek frame bhi na bane."
  },
  {
   "id": "v2",
   "group": "g6",
   "start": 42.697,
   "end": 50.437,
   "text": "Isliye computer dibbe ke andar dibbe banata hai, jise BVH kehte hain. Das crore triangles mein bhi lagbhag sattais baar dibbe check karke jawab mil jata hai, yeh ideal hisaab hai.",
   "cap": "Isliye computer dibbe ke andar dibbe banata hai, jise BVH kehte hain. Das crore triangles mein bhi lagbhag sattais baar dibbe check karke jawab mil jata hai, yeh ideal hisaab hai."
  },
  {
   "id": "y1",
   "group": "g7",
   "start": 51.352,
   "end": 62.492,
   "text": "Idea naya nahi hai. 1968 mein Arthur Appel ne pehla version likha. 1979-80 mein Turner Whitted ne uchhalti aur sheeshe se guzarti kirnein judin. 2006 mein Pixar ki film Cars ka ek frame banane mein ausatan satrah ghante lage.",
   "cap": "Idea naya nahi hai. 1968 mein Arthur Appel ne pehla version likha. 1979-80 mein Turner Whitted ne uchhalti aur sheeshe se guzarti kirnein judin. 2006 mein Pixar ki film Cars ka ek frame banane mein ausatan satrah ghante lage."
  },
  {
   "id": "y2",
   "group": "g8",
   "start": 63.601,
   "end": 70.531,
   "text": "Phir 2018 mein NVIDIA ne RTX card dikhaya, jisme isi kaam ke liye alag hardware hai. Company ka daawa: das arab kirnein prati second tak.",
   "cap": "Phir 2018 mein NVIDIA ne RTX card dikhaya, jisme isi kaam ke liye alag hardware hai. Company ka daawa: das arab kirnein prati second tak."
  },
  {
   "id": "m1",
   "group": "g9",
   "start": 71.238,
   "end": 78.653,
   "text": "Math karo. Full HD screen, saath frame prati second, yaani lagbhag saadhe bara crore pixel har second. Daawa sahi maano to kaagaz par lagbhag assi kirnein har pixel ke liye.",
   "cap": "Math karo. Full HD screen, saath frame prati second, yaani lagbhag saadhe bara crore pixel har second. Daawa sahi maano to kaagaz par lagbhag assi kirnein har pixel ke liye."
  },
  {
   "id": "n1",
   "group": "g10",
   "start": 79.671,
   "end": 85.314,
   "text": "Par asli game mein bahut kam kirnein milti hain, isliye tasveer daane-daane wali banti hai. Phir ek denoiser us shor ko saaf karta hai.",
   "cap": "Par asli game mein bahut kam kirnein milti hain, isliye tasveer daane-daane wali banti hai. Phir ek denoiser us shor ko saaf karta hai."
  },
  {
   "id": "e1",
   "group": "g11",
   "start": 86.295,
   "end": 91.518,
   "text": "To jo aap dekhte ho, woh kuch asli kirnein hain aur baaki andaza. Aur zyadatar game ab bhi purane tareeke ke saath mila kar bante hain.",
   "cap": "To jo aap dekhte ho, woh kuch asli kirnein hain aur baaki andaza. Aur zyadatar game ab bhi purane tareeke ke saath mila kar bante hain."
  },
  {
   "id": "f1",
   "group": "g12",
   "start": 92.557,
   "end": 98.577,
   "text": "Agli baar puddle mein peeche ki building dikhe, to yaad rakhna: kisi ne aankh se ek kiran ulti bheji aur pixel ne poocha, mere peeche kya hai?",
   "cap": "Agli baar puddle mein peeche ki building dikhe, to yaad rakhna: kisi ne aankh se ek kiran ulti bheji aur pixel ne poocha, mere peeche kya hai?"
  },
  {
   "id": "cta",
   "group": "g12",
   "start": 98.477,
   "end": 103.637,
   "text": "Yeh us dost ko bhejiye jo kehta hai graphics sirf GPU ka khel hai. Like, share aur subscribe karein, Sandesh Explains.",
   "cap": "Yeh us dost ko bhejiye jo kehta hai graphics sirf GPU ka khel hai. Like, share aur subscribe karein, Sandesh Explains."
  }
