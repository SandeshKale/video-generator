{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 5.761,
   "text": "Duniya ki sabse keemti chip company ke boss ne ek chitthi likhi. Chitthi mein maafi hai, jaanch hai, aur teen taraf ke bayaan.",
   "cap": "Duniya ki sabse keemti chip company ke boss ne ek chitthi likhi. Chitthi mein maafi hai, jaanch hai, aur teen taraf ke bayaan."
  },
  {
   "id": "h2",
   "group": "g1",
   "start": 5.561,
   "end": 6.961,
   "text": "Saboot? Wo pata nahi.",
   "cap": "Saboot? Wo pata nahi."
  },
  {
   "id": "c1",
   "group": "g2",
   "start": 7.954,
   "end": 14.758,
   "text": "Pehle jo pakka hai. Aath november ko Jensen Huang ne chitthi mein likha, maine apni patni se bewafai ki. Unhone maafi maangi.",
   "cap": "Pehle jo pakka hai. Aath november ko Jensen Huang ne chitthi mein likha, maine apni patni se bewafai ki. Unhone maafi maangi."
  },
  {
   "id": "c2",
   "group": "g2",
   "start": 14.138,
   "end": 19.978,
   "text": "Company ne bahar ke vakeelon se jaanch shuru kar di. Yahan tak sab confirmed hai. Ab shuru hota hai, reportedly.",
   "cap": "Company ne bahar ke vakeelon se jaanch shuru kar di. Yahan tak sab confirmed hai. Ab shuru hota hai, reportedly."
  },
  {
   "id": "n1",
   "group": "g3",
   "start": 20.57,
   "end": 29.668,
   "text": "New York Times ke mutabiq, American officials maante hain ki Singapore ki chip kharidne wali company Megaspeed ki ek poorv executive, China ki intelligence ke liye kaam karti thi.",
   "cap": "New York Times ke mutabiq, American officials maante hain ki Singapore ki chip kharidne wali company Megaspeed ki ek poorv executive, China ki intelligence ke liye kaam karti thi."
  },
  {
   "id": "n2",
   "group": "g3",
   "start": 29.528,
   "end": 32.668,
   "text": "Wo memo public nahi hai. China ise sire se nakarta hai.",
   "cap": "Wo memo public nahi hai. China ise sire se nakarta hai."
  },
  {
   "id": "n3",
   "group": "g4",
   "start": 33.329,
   "end": 37.789,
   "text": "Inka surname bhi Huang hai, par koi rishta nahi. Haan, sabse pehle wahi check hua.",
   "cap": "Inka surname bhi Huang hai, par koi rishta nahi. Haan, sabse pehle wahi check hua."
  },
  {
   "id": "n4",
   "group": "g4",
   "start": 37.269,
   "end": 43.749,
   "text": "Megaspeed par pehle se jaanch chal rahi hai ki kya usne China ke grahakon tak chip pahunchai. Company inkaar karti hai.",
   "cap": "Megaspeed par pehle se jaanch chal rahi hai ki kya usne China ke grahakon tak chip pahunchai. Company inkaar karti hai."
  },
  {
   "id": "e1",
   "group": "g5",
   "start": 44.368,
   "end": 52.995,
   "text": "Ab sabke bayaan suniye. Nvidia ka board: secrets leak hone ki koi wajah nahi dikhti. China: bina saboot ki badnaami. Singapore: humne unhe kabhi jaancha hi nahi.",
   "cap": "Ab sabke bayaan suniye. Nvidia ka board: secrets leak hone ki koi wajah nahi dikhti. China: bina saboot ki badnaami. Singapore: humne unhe kabhi jaancha hi nahi."
  },
  {
   "id": "e2",
   "group": "g6",
   "start": 53.578,
   "end": 58.406,
   "text": "Aur America ka wo memo? Kisi ne dikhaya nahi. Chaar folder, chaar bayaan, saboot ke chaar khaali khaane.",
   "cap": "Aur America ka wo memo? Kisi ne dikhaya nahi. Chaar folder, chaar bayaan, saboot ke chaar khaali khaane."
  },
  {
   "id": "s1",
   "group": "g7",
   "start": 59.016,
   "end": 62.779,
   "text": "Aapko isse kya? Aapke kai AI app usi company ki chip par chalte hain.",
   "cap": "Aapko isse kya? Aapke kai AI app usi company ki chip par chalte hain."
  },
  {
   "id": "s2",
   "group": "g7",
   "start": 62.439,
   "end": 67.839,
   "text": "Isiliye somvaar ko pre-market mein share kareeb paanch percent gira. Chip ek, bhaav roz ka.",
   "cap": "Isiliye somvaar ko pre-market mein share kareeb paanch percent gira. Chip ek, bhaav roz ka."
  },
  {
   "id": "u1",
   "group": "g8",
   "start": 68.454,
   "end": 77.035,
   "text": "Ab sach-sach, kya nahi pata. Koi charge nahi laga. Kisi ne sabke saamne ye nahi dikhaya ki wo China ke liye kaam karti thi. Aur ye bhi nahi ki unhone koi secret bataya.",
   "cap": "Ab sach-sach, kya nahi pata. Koi charge nahi laga. Kisi ne sabke saamne ye nahi dikhaya ki wo China ke liye kaam karti thi. Aur ye bhi nahi ki unhone koi secret bataya."
  },
  {
   "id": "u2",
   "group": "g9",
   "start": 77.629,
   "end": 82.578,
   "text": "Yaani abhi tak: ek confirmed chitthi, ek reported memo, aur ek bahut lamba, pata nahi.",
   "cap": "Yaani abhi tak: ek confirmed chitthi, ek reported memo, aur ek bahut lamba, pata nahi."
  },
  {
   "id": "r1",
   "group": "g10",
   "start": 83.079,
   "end": 87.064,
   "text": "Aisi khabar ka ek hi niyam hai: pehle dekho kisne kaha, phir dekho saboot kahan hai.",
   "cap": "Aisi khabar ka ek hi niyam hai: pehle dekho kisne kaha, phir dekho saboot kahan hai."
  },
  {
   "id": "cta",
   "group": "g11",
   "start": 87.553,
   "end": 94.534,
   "text": "Yeh us dost ko bhejiye jo har forward par yakeen kar leta hai. Like, share aur subscribe karein, Sandesh Explains.",
   "cap": "Yeh us dost ko bhejiye jo har forward par yakeen kar leta hai. Like, share aur subscribe karein, Sandesh Explains."
  }
 ],
