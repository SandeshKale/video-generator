{
 "sentences": [
  {
   "id": "g1",
   "group": "g1",
   "start": 0.0,
   "end": 2.23,
   "text": "GTA 6 aa raha hai! Par ek baat sunke chaunk jaoge.",
   "cap": "GTA 6 aa raha hai! Par ek baat sunke chaunk jaoge."
  },
  {
   "id": "g2",
   "group": "g2",
   "start": 3.307,
   "end": 8.627,
   "text": "NVIDIA ke mutabiq, aise games mein har 16 mein se 15 pixel, asli tareeke se bane hi nahi. AI ne andaaza lagaya!",
   "cap": "NVIDIA ke mutabiq, aise games mein har 16 mein se 15 pixel, asli tareeke se bane hi nahi. AI ne andaaza lagaya!"
  },
  {
   "id": "g3",
   "group": "g3",
   "start": 9.364,
   "end": 13.389,
   "text": "Pehle samjho, tasveer hoti kya hai. Jaali wali khidki dekho. Har chhed se bas ek rang dikhta hai.",
   "cap": "Pehle samjho, tasveer hoti kya hai. Jaali wali khidki dekho. Har chhed se bas ek rang dikhta hai."
  },
  {
   "id": "g4",
   "group": "g4",
   "start": 13.962,
   "end": 16.545,
   "text": "Phone ki screen bhi aisi hi jaali hai. Har chhed ko pixel kehte hain.",
   "cap": "Phone ki screen bhi aisi hi jaali hai. Har chhed ko pixel kehte hain."
  },
  {
   "id": "g5",
   "group": "g5",
   "start": 17.544,
   "end": 19.604,
   "text": "Aur 4K screen mein, aise 83 lakh chhed hain!",
   "cap": "Aur 4K screen mein, aise 83 lakh chhed hain!"
  },
  {
   "id": "g6",
   "group": "g6",
   "start": 20.351,
   "end": 23.342,
   "text": "Har chhed ka rang aata kahaan se hai? Roshni se. Raat ko kuen mein chaand dikhta hai na?",
   "cap": "Har chhed ka rang aata kahaan se hai? Roshni se. Raat ko kuen mein chaand dikhta hai na?"
  },
  {
   "id": "g7",
   "group": "g7",
   "start": 24.383,
   "end": 27.419,
   "text": "Chaand ki roshni paani se takraati hai, mudti hai, aur aapki aankh tak aati hai.",
   "cap": "Chaand ki roshni paani se takraati hai, mudti hai, aur aapki aankh tak aati hai."
  },
  {
   "id": "g8",
   "group": "g8",
   "start": 27.974,
   "end": 30.971,
   "text": "Game yahi kaam ulta karta hai. Aankh se har chhed ki taraf ek dhaaga bhejo.",
   "cap": "Game yahi kaam ulta karta hai. Aankh se har chhed ki taraf ek dhaaga bhejo."
  },
  {
   "id": "g9",
   "group": "g9",
   "start": 31.514,
   "end": 34.732,
   "text": "Dhaaga jahaan takraaye, wahaan se poochho: yahaan kitni roshni hai? Isko ray tracing kehte hain.",
   "cap": "Dhaaga jahaan takraaye, wahaan se poochho: yahaan kitni roshni hai? Isko ray tracing kehte hain."
  },
  {
   "id": "g10",
   "group": "g10",
   "start": 35.685,
   "end": 38.949,
   "text": "Par ek tasveer ke liye 83 lakh dhaage. Aur ek second mein 60 tasveerein.",
   "cap": "Par ek tasveer ke liye 83 lakh dhaage. Aur ek second mein 60 tasveerein."
  },
  {
   "id": "g11",
   "group": "g11",
   "start": 39.468,
   "end": 44.056,
   "text": "Yaani har second, 50 crore dhaage! Film Cars ki ek tasveer banane mein, ausatan 17 ghante lage the.",
   "cap": "Yaani har second, 50 crore dhaage! Film Cars ki ek tasveer banane mein, ausatan 17 ghante lage the."
  },
  {
   "id": "g12",
   "group": "g12",
   "start": 44.645,
   "end": 49.733,
   "text": "Toh graphics card jugaad karta hai. Pehla jugaad: kam dhaage bhejo. Tasveer bindiyon wali banti hai, jaise rangoli ke bindu.",
   "cap": "Toh graphics card jugaad karta hai. Pehla jugaad: kam dhaage bhejo. Tasveer bindiyon wali banti hai, jaise rangoli ke bindu."
  },
  {
   "id": "g13",
   "group": "g13",
   "start": 50.238,
   "end": 56.004,
   "text": "Phir AI, ek maahir rangoli wali ki tarah, bindu jodkar poori tasveer bana deta hai. NVIDIA ise Ray Reconstruction kehta hai.",
   "cap": "Phir AI, ek maahir rangoli wali ki tarah, bindu jodkar poori tasveer bana deta hai. NVIDIA ise Ray Reconstruction kehta hai."
  },
  {
   "id": "g14",
   "group": "g14",
   "start": 56.511,
   "end": 61.19,
   "text": "Doosra jugaad: tasveer chhoti banao, chaar mein se sirf ek pixel. Phir AI use bada aur saaf kar deta hai.",
   "cap": "Doosra jugaad: tasveer chhoti banao, chaar mein se sirf ek pixel. Phir AI use bada aur saaf kar deta hai."
  },
  {
   "id": "g15",
   "group": "g15",
   "start": 61.757,
   "end": 65.43,
   "text": "Jaise cinema ka painter, chhoti si photo dekhkar, bada poster bana deta hai. Yeh hai DLSS.",
   "cap": "Jaise cinema ka painter, chhoti si photo dekhkar, bada poster bana deta hai. Yeh hai DLSS."
  },
  {
   "id": "g16",
   "group": "g16",
   "start": 66.333,
   "end": 72.522,
   "text": "Teesra jugaad: copy ke kone par banayi flip-book yaad hai? Card ek asli tasveer banata hai, aur beech ki teen tasveerein, AI khud bana deta hai.",
   "cap": "Teesra jugaad: copy ke kone par banayi flip-book yaad hai? Card ek asli tasveer banata hai, aur beech ki teen tasveerein, AI khud bana deta hai."
  },
  {
   "id": "g17",
   "group": "g17",
   "start": 73.038,
   "end": 74.686,
   "text": "Isko Frame Generation kehte hain.",
   "cap": "Isko Frame Generation kehte hain."
  },
  {
   "id": "g18",
   "group": "g18",
   "start": 75.454,
   "end": 78.693,
   "text": "Ab jodo. Chaar mein se ek pixel, aur chaar mein se ek tasveer. Ek bata solah!",
   "cap": "Ab jodo. Chaar mein se ek pixel, aur chaar mein se ek tasveer. Ek bata solah!"
  },
  {
   "id": "g19",
   "group": "g19",
   "start": 79.451,
   "end": 82.374,
   "text": "Isiliye NVIDIA kehta hai, 16 mein se 15 pixel AI ke.",
   "cap": "Isiliye NVIDIA kehta hai, 16 mein se 15 pixel AI ke."
  },
  {
   "id": "g20",
   "group": "g20",
   "start": 83.01,
   "end": 87.514,
   "text": "Par ek pench hai. Flip-book ke pehle se bane panne, aapka button nahi sunte. Isliye thoda lag lagta hai.",
   "cap": "Par ek pench hai. Flip-book ke pehle se bane panne, aapka button nahi sunte. Isliye thoda lag lagta hai."
  },
  {
   "id": "g21",
   "group": "g21",
   "start": 88.163,
   "end": 93.541,
   "text": "Aur GTA 6 abhi PS5 aur Xbox par aa raha hai. DLSS, NVIDIA ke PC card ka feature hai.",
   "cap": "Aur GTA 6 abhi PS5 aur Xbox par aa raha hai. DLSS, NVIDIA ke PC card ka feature hai."
  },
  {
   "id": "g22",
   "group": "g22",
   "start": 94.035,
   "end": 96.24,
   "text": "Rockstar ne nahi bataya ki GTA 6 mein yeh hoga.",
   "cap": "Rockstar ne nahi bataya ki GTA 6 mein yeh hoga."
  },
  {
   "id": "g23",
   "group": "g23",
   "start": 96.827,
   "end": 100.531,
   "text": "Aisi aur seedhi baaton ke liye, like, share aur subscribe karein, nerdlogic.co ko!",
   "cap": "Aisi aur seedhi baaton ke liye, like, share aur subscribe karein, nerdlogic.co ko!"
  }
