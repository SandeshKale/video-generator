{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 5.938,
   "text": "GTA 6, unnees november! Par suno, NVIDIA ka daawa hai, kuch games mein tasveer ke solah mein se pandrah pixel asli hote hi nahi!",
   "cap": "GTA 6, unnees november! Par suno, NVIDIA ka daawa hai, kuch games mein tasveer ke solah mein se pandrah pixel asli hote hi nahi!"
  },
  {
   "id": "p1",
   "group": "g2",
   "start": 7.003,
   "end": 10.588,
   "text": "Toh gaadi ke neeche puddle mein woh building kaun banata hai? Chalo, bachchon ki tarah samjhte hain!",
   "cap": "Toh gaadi ke neeche puddle mein woh building kaun banata hai? Chalo, bachchon ki tarah samjhte hain!"
  },
  {
   "id": "r1",
   "group": "g3",
   "start": 11.305,
   "end": 16.129,
   "text": "Pehle yeh: puddle mein building kyun dikhti hai? Torch ko sheeshe par maaro, roshni uchhalti hai! Bas yehi reflection hai!",
   "cap": "Pehle yeh: puddle mein building kyun dikhti hai? Torch ko sheeshe par maaro, roshni uchhalti hai! Bas yehi reflection hai!"
  },
  {
   "id": "b1",
   "group": "g4",
   "start": 16.811,
   "end": 21.774,
   "text": "Par computer ke liye? Ek sooraj se arbon kirnein, har kiran kai baar uchhalti hai! Sabko follow karna? Naamumkin!",
   "cap": "Par computer ke liye? Ek sooraj se arbon kirnein, har kiran kai baar uchhalti hai! Sabko follow karna? Naamumkin!"
  },
  {
   "id": "b2",
   "group": "g5",
   "start": 22.551,
   "end": 28.675,
   "text": "Toh computer ulta chalta hai! Aankh se ek kiran bhejo, har pixel ke liye ek, jahan takraye, wahan ka rang utha lo! Ise kehte hain ray tracing!",
   "cap": "Toh computer ulta chalta hai! Aankh se ek kiran bhejo, har pixel ke liye ek, jahan takraye, wahan ka rang utha lo! Ise kehte hain ray tracing!"
  },
  {
   "id": "s1",
   "group": "g6",
   "start": 29.618,
   "end": 39.159,
   "text": "Par 4K screen mein tiraasi lakh pixel hain! Har pixel ki kai kirnein, aur har second saath baar! Pixar ki Cars ka ek frame, sattrah ghante! Game ko milta hai, second ka saathva hissa! Yaani chhattis lakh guna tez!",
   "cap": "Par 4K screen mein tiraasi lakh pixel hain! Har pixel ki kai kirnein, aur har second saath baar! Pixar ki Cars ka ek frame, sattrah ghante! Game ko milta hai, second ka saathva hissa! Yaani chhattis lakh guna tez!"
  },
  {
   "id": "s2",
   "group": "g7",
   "start": 39.844,
   "end": 42.434,
   "text": "Seedha hisaab? Naamumkin. Toh GPU ne kiya jugaad! Ek nahi, teen!",
   "cap": "Seedha hisaab? Naamumkin. Toh GPU ne kiya jugaad! Ek nahi, teen!"
  },
  {
   "id": "c1",
   "group": "g8",
   "start": 43.186,
   "end": 50.951,
   "text": "Jugaad ek: kam kirnein! Bas thode dots, dhundhli tasveer. Phir AI artist dots jodkar poori tasveer bana deta hai, bilkul dot to dot jaisa! Ise kehte hain Ray Reconstruction!",
   "cap": "Jugaad ek: kam kirnein! Bas thode dots, dhundhli tasveer. Phir AI artist dots jodkar poori tasveer bana deta hai, bilkul dot to dot jaisa! Ise kehte hain Ray Reconstruction!"
  },
  {
   "id": "c2",
   "group": "g9",
   "start": 52.051,
   "end": 60.062,
   "text": "Jugaad do: chhoti tasveer banao! Chaar mein se sirf ek pixel! Phir AI use bada karke sharp kar deta hai, jaise chhote sticker ko bade poster mein! Yeh hai DLSS Super Resolution!",
   "cap": "Jugaad do: chhoti tasveer banao! Chaar mein se sirf ek pixel! Phir AI use bada karke sharp kar deta hai, jaise chhote sticker ko bade poster mein! Yeh hai DLSS Super Resolution!"
  },
  {
   "id": "c3",
   "group": "g10",
   "start": 60.902,
   "end": 68.065,
   "text": "Jugaad teen: flip book! Aap ek frame banao, AI beech ke frame khud banata hai! NVIDIA kehta hai, ek asli frame ke peeche paanch tak! Multi Frame Generation!",
   "cap": "Jugaad teen: flip book! Aap ek frame banao, AI beech ke frame khud banata hai! NVIDIA kehta hai, ek asli frame ke peeche paanch tak! Multi Frame Generation!"
  },
  {
   "id": "m1",
   "group": "g11",
   "start": 68.779,
   "end": 74.602,
   "text": "Ab teeno jodo: 4K ke taintees million pixel mein se sirf do million asli! Baaki solah mein se pandrah, AI! NVIDIA ka daawa hai.",
   "cap": "Ab teeno jodo: 4K ke taintees million pixel mein se sirf do million asli! Baaki solah mein se pandrah, AI! NVIDIA ka daawa hai."
  },
  {
   "id": "k1",
   "group": "g12",
   "start": 75.543,
   "end": 80.566,
   "text": "Par catch! AI wale frame ne aapka button press dekha hi nahi! Isliye lag aata hai. NVIDIA ka jawab, Reflex.",
   "cap": "Par catch! AI wale frame ne aapka button press dekha hi nahi! Isliye lag aata hai. NVIDIA ka jawab, Reflex."
  },
  {
   "id": "k2",
   "group": "g13",
   "start": 81.158,
   "end": 86.144,
   "text": "Aur GTA 6 console par hai, DLSS NVIDIA ke PC ka hai, Rockstar ne yeh sab confirm nahi kiya!",
   "cap": "Aur GTA 6 console par hai, DLSS NVIDIA ke PC ka hai, Rockstar ne yeh sab confirm nahi kiya!"
  },
  {
   "id": "e1",
   "group": "g14",
   "start": 86.87,
   "end": 92.358,
   "text": "Toh agli baar jab puddle mein building dikhe, yaad rakhna: kuch kirnein asli, baaki AI ka andaza! Aur woh bhi saath baar har second!",
   "cap": "Toh agli baar jab puddle mein building dikhe, yaad rakhna: kuch kirnein asli, baaki AI ka andaza! Aur woh bhi saath baar har second!"
  },
  {
   "id": "f1",
   "group": "g15",
   "start": 93.05,
   "end": 95.413,
   "text": "Yeh us dost ko bhejo jo kehta hai game mein sab asli hai!",
   "cap": "Yeh us dost ko bhejo jo kehta hai game mein sab asli hai!"
  },
  {
   "id": "cta",
   "group": "g16",
   "start": 96.143,
   "end": 98.836,
   "text": "Like, share aur subscribe karein, nerdlogic.co ko.",
   "cap": "Like, share aur subscribe karein, nerdlogic.co ko."
  }
