{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 4.407,
   "text": "Blinkit और Zepto से कहा गया, दस minute बोलना बंद करो।",
   "cap": "Blinkit aur Zepto se kaha gaya, das minute bolna band karo."
  },
  {
   "id": "h2",
   "group": "g2",
   "start": 3.554,
   "end": 6.798,
   "text": "फिर भी दूध उतनी ही जल्दी आता है। कैसे?",
   "cap": "Phir bhi doodh utni hi jaldi aata hai. Kaise?"
  },
  {
   "id": "p1",
   "group": "g2",
   "start": 6.418,
   "end": 13.458,
   "text": "राइडर की speed नहीं, असली खेल order करने से पहले हो चुका होता है। तीन फ़ैसले, और तीनों, आपके tap से पहले।",
   "cap": "Rider ki speed nahi, asli khel order karne se pehle ho chuka hota hai. Teen faisle, aur teeno, aapke tap se pehle."
  },
  {
   "id": "d1a",
   "group": "g3",
   "start": 11.287,
   "end": 17.057,
   "text": "पहला, कौन सा store। हर dark store का नक्शे पर एक घेरा है, जिसे geofence कहते हैं।",
   "cap": "Pehla, kaun sa store. Har dark store ka naqshe par ek ghera hai, jise geofence kehte hain."
  },
  {
   "id": "d1b",
   "group": "g3",
   "start": 16.577,
   "end": 20.677,
   "text": "आपका order उसी store को जाता है, जिसके घेरे में आप हों।",
   "cap": "Aapka order usi store ko jaata hai, jiske ghere mein aap hon."
  },
  {
   "id": "d2a",
   "group": "g4",
   "start": 18.608,
   "end": 20.883,
   "text": "दूसरा, shelf पर क्या रखना है।",
   "cap": "Doosra, shelf par kya rakhna hai."
  },
  {
   "id": "d2b",
   "group": "g4",
   "start": 20.663,
   "end": 26.283,
   "text": "ये हर PIN code के लिए, पहले ही forecast हो जाता है, त्योहार और cricket match के साथ।",
   "cap": "Ye har PIN code ke liye, pehle hi forecast ho jaata hai, tyohaar aur cricket match ke saath."
  },
  {
   "id": "d3a",
   "group": "g5",
   "start": 24.831,
   "end": 33.062,
   "text": "तीसरा, packing। Packer के handheld पर, हर item का bin दिखता है। Barcode scan होता है, और अंडे? सबसे आख़िर में।",
   "cap": "Teesra, packing. Packer ke handheld par, har item ka bin dikhta hai. Barcode scan hota hai, aur ande? Sabse aakhir mein."
  },
  {
   "id": "d3b",
   "group": "g5",
   "start": 32.882,
   "end": 37.422,
   "text": "राइडर अंदर आता ही नहीं, बस अपना bag scan करता है, और निकल जाता है।",
   "cap": "Rider andar aata hi nahi, bas apna bag scan karta hai, aur nikal jaata hai."
  },
  {
   "id": "w1a",
   "group": "g6",
   "start": 34.339,
   "end": 37.382,
   "text": "तो दस minute का वादा, सिर्फ़ marketing नहीं था।",
   "cap": "Toh das minute ka vaada, sirf marketing nahi tha."
  },
  {
   "id": "w1b",
   "group": "g6",
   "start": 37.122,
   "end": 42.202,
   "text": "Reuters के मुताबिक, चिंता rider की speed की थी, और देर होने पर, कम pay की।",
   "cap": "Reuters ke mutabik, chinta rider ki speed ki thi, aur der hone par, kam pay ki."
  },
  {
   "id": "w2",
   "group": "g7",
   "start": 40.445,
   "end": 45.443,
   "text": "अब Blinkit खुद को, Groceries and more कहता है। घड़ी बदली, system नहीं।",
   "cap": "Ab Blinkit khud ko, Groceries and more kehta hai. Ghadi badli, system nahi."
  },
  {
   "id": "s1",
   "group": "g7",
   "start": 45.183,
   "end": 53.043,
   "text": "अकेले Blinkit के, पौने तीन हज़ार dark stores हैं। तीन महीनों में, orders की value, करीब इक्कीस हज़ार करोड़ रुपये।",
   "cap": "Akele Blinkit ke, paune teen hazaar dark stores hain. Teen mahino mein, orders ki value, kareeb ikkees hazaar crore rupaye."
  },
  {
   "id": "c1",
   "group": "g8",
   "start": 49.884,
   "end": 54.353,
   "text": "क्या दस minute का वादा, वापस आना चाहिए? कमेंट में बताओ।",
   "cap": "Kya das minute ka vaada, wapas aana chahiye? Comment mein batao."
  },
  {
   "id": "c2",
   "group": "g8",
   "start": 53.933,
   "end": 57.633,
   "text": "Sandesh Explains को, like, share और subscribe करना।",
   "cap": "Sandesh Explains ko, like, share aur subscribe karna."
  }
 ],
