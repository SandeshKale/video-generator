{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 3.836,
   "text": "GTA 6 ka mobile download dhoondh rahe ho? Wo game nahi, virus hai.",
   "cap": "GTA 6 ka mobile download dhoondh rahe ho? Wo game nahi, virus hai."
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 4.434,
   "end": 11.372,
   "text": "Security companies ne pakda hai: fake GTA 6 installer aur APK ke naam pe password churane wala malware baanta ja raha hai.",
   "cap": "Security companies ne pakda hai: fake GTA 6 installer aur APK ke naam pe password churane wala malware baanta ja raha hai."
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 11.909,
   "end": 20.716,
   "text": "Sach ye hai: Rockstar ne GTA 6 sirf PlayStation 5 aur Xbox Series ke liye launch kiya. Mobile version announce hi nahi hua. PC bhi abhi nahi.",
   "cap": "Sach ye hai: Rockstar ne GTA 6 sirf PlayStation 5 aur Xbox Series ke liye launch kiya. Mobile version announce hi nahi hua. PC bhi abhi nahi."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 21.168,
   "end": 30.894,
   "text": "To phone pe chalega kyun nahi? PS5 ke graphics chip ki taaqat das point do aath teraflops hai. Yaani har second das lakh crore se zyada hisaab. Saath mein solah GB memory.",
   "cap": "To phone pe chalega kyun nahi? PS5 ke graphics chip ki taaqat das point do aath teraflops hai. Yaani har second das lakh crore se zyada hisaab. Saath mein solah GB memory."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 31.422,
   "end": 38.106,
   "text": "Aur poora PS5 khelte waqt lagbhag do sau watt bijli kheenchta hai. Isliye uske andar bada pankha aur heat sink hai.",
   "cap": "Aur poora PS5 khelte waqt lagbhag do sau watt bijli kheenchta hai. Isliye uske andar bada pankha aur heat sink hai."
  },
  {
   "id": "s6",
   "group": "g6",
   "start": 38.674,
   "end": 47.184,
   "text": "Phone mein itni garmi nikaalne ki jagah nahi. Kuch flagship phones ne bees minute ke stress test mein aadhi se zyada speed gira di. Isko kehte hain thermal throttling.",
   "cap": "Phone mein itni garmi nikaalne ki jagah nahi. Kuch flagship phones ne bees minute ke stress test mein aadhi se zyada speed gira di. Isko kehte hain thermal throttling."
  },
  {
   "id": "s7",
   "group": "g7",
   "start": 47.591,
   "end": 52.011,
   "text": "Ye test game se zyada kadak hote hain, par baat wahi: garam chip khud dheema ho jaata hai.",
   "cap": "Ye test game se zyada kadak hote hain, par baat wahi: garam chip khud dheema ho jaata hai."
  },
  {
   "id": "s8",
   "group": "g8",
   "start": 52.581,
   "end": 60.281,
   "text": "Phone pe GTA khelna hai? Rockstar ka apna GTA San Andreas, do hazaar terah se mobile pe hai. Bas wahi download karo, official store se.",
   "cap": "Phone pe GTA khelna hai? Rockstar ka apna GTA San Andreas, do hazaar terah se mobile pe hai. Bas wahi download karo, official store se."
  },
  {
   "id": "s9",
   "group": "g9",
   "start": 60.73,
   "end": 68.603,
   "text": "Jo bhi GTA 6 APK bheje, wo scam hai. Ye video us dost ko bhejo jo download dhoondh raha hai. Uska phone aur bank account, dono bach sakte hain.",
   "cap": "Jo bhi GTA 6 APK bheje, wo scam hai. Ye video us dost ko bhejo jo download dhoondh raha hai. Uska phone aur bank account, dono bach sakte hain."
  },
  {
   "id": "s10",
   "group": "g10",
   "start": 69.177,
   "end": 71.501,
   "text": "Follow aur share kariye, nerdlogic.co ko.",
   "cap": "Follow aur share kariye, nerdlogic.co ko."
  }
 ],
