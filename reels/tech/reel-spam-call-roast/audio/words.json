 "B": {
  "h1": "दो बजकर सैंतालीस मिनट। मीटिंग में हो। अननोन नंबर।",
  "h2": "उठाया: सर, लोन चाहिए? आपने लोन माँगा ही नहीं था।",
  "h3": "लोन ने आपको ढूँढा।",
  "s1": "पिछले साल भारत में स्पैम कॉल: चालीस एक अरब से ज़्यादा।",
  "s2": "ट्रूकॉलर के अपने यूज़र्स को लगभग बयालीस अरब।",
  "s3": "रफ़ मैथ्स: हर यूज़र को महीने के दस। इससे कम तो मेरी ईएमआई की याद आती है।",
  "t1": "सरकार ने कहा: टेलीमार्केटर एक अलग गली में रहेंगे। टेलीमार्केटिंग के लिए चौदह सौ, सर्विस वालों के लिए सोलह सौ।",
  "t2": "ताकि पता चले: यह दुकान है।",
  "r1": "पर अब वही गली सबसे बदनाम है।",
  "r2": "आठ महीने में चौदह सौ की इक्यासी परसेंट कॉल इग्नोर हुईं, सोलह सौ की उन्यासी।",
  "r3": "और ट्रूकॉलर उस गली को स्पैम बोल भी नहीं सकता। बोल सकता है: फ़्रीक्वेंटली ब्लॉक्ड। यानी स्पैम का सभ्य नाम।",
  "f1": "और जो सच में फ्रॉड है, वह भी बोलता है: बैंक, पुलिस, पेमेंट ऐप।",
  "f2": "सात सौ सत्तर करोड़ फ्रॉड कॉल।",
  "f3": "एक कॉल का औसत डेढ़ मिनट। ब्लॉकिंग से रोज़ लगभग दो सौ सैंतालीस साल का समय बचा। रोज़।",
  "d1": "मेरे घर में हर अननोन कॉल पापा के लिए बात करने का मौक़ा है। और स्कैमर को वही चाहिए: कोई जो फ़ोन रखना न जाने।",
  "x1": "अठारह सितंबर को ट्राई ने कहा: स्पैम रिपोर्ट करवाने वाले ऐप, वो रिपोर्ट्स टेलीकॉम के प्लेटफ़ॉर्म को भेजेंगे।",
  "x2": "बिना बताए रोबोकॉल सीधे स्पैम।",
  "x3": "और मशीन की कॉल पर पाँच पैसे प्रति मिनट तक चार्ज। स्पैम के लिए भी अब कॉल रेट।",
  "x4": "पर काम करेगा? अभी कोई नहीं जानता। ट्रूकॉलर इसे एंटी-कॉम्पिटिटिव बोलता है।",
  "c1": "तो अगली बार लोन चाहिए आए, याद रखना: उस लोन को अब डिक्लेयर करना पड़ेगा।",
  "cta": "ये उस दोस्त को भेजिए जो कहता है, मैं तो कभी उठाता ही नहीं। लाइक, शेयर और सब्सक्राइब करिए, संदेश एक्सप्लेन्स को।"
 }
}