{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 2.746,
   "text": "Do bajkar saintalis minute. Meeting mein ho. Unknown number.",
   "cap": "Do bajkar saintalis minute. Meeting mein ho. Unknown number."
  },
  {
   "id": "h2",
   "group": "g1",
   "start": 2.426,
   "end": 5.686,
   "text": "Uthaya: \"Sir, loan chahiye?\" Aapne loan maanga hi nahi tha.",
   "cap": "Uthaya: \"Sir, loan chahiye?\" Aapne loan maanga hi nahi tha."
  },
  {
   "id": "h3",
   "group": "g2",
   "start": 6.724,
   "end": 7.806,
   "text": "Loan ne aapko dhoondha.",
   "cap": "Loan ne aapko dhoondha."
  },
  {
   "id": "s1",
   "group": "g3",
   "start": 8.398,
   "end": 11.884,
   "text": "Pichle saal India mein spam calls: 41 arab se zyada.",
   "cap": "Pichle saal India mein spam calls: 41 arab se zyada."
  },
  {
   "id": "s2",
   "group": "g3",
   "start": 11.144,
   "end": 14.384,
   "text": "Truecaller ke apne users ko lagbhag 42 arab.",
   "cap": "Truecaller ke apne users ko lagbhag 42 arab."
  },
  {
   "id": "s3",
   "group": "g4",
   "start": 14.919,
   "end": 19.375,
   "text": "Rough maths: har user ko mahine ke das. Isse kam to meri EMI ki yaad aati hai.",
   "cap": "Rough maths: har user ko mahine ke das. Isse kam to meri EMI ki yaad aati hai."
  },
  {
   "id": "t1",
   "group": "g5",
   "start": 19.884,
   "end": 25.985,
   "text": "Sarkar ne kaha: telemarketer alag gali mein rahenge. Telemarketing ke liye 1400, service wale 1600.",
   "cap": "Sarkar ne kaha: telemarketer alag gali mein rahenge. Telemarketing ke liye 1400, service wale 1600."
  },
  {
   "id": "t2",
   "group": "g5",
   "start": 25.785,
   "end": 27.925,
   "text": "Taaki pata chale: yeh dukaan hai.",
   "cap": "Taaki pata chale: yeh dukaan hai."
  },
  {
   "id": "r1",
   "group": "g6",
   "start": 28.471,
   "end": 30.479,
   "text": "Par ab wahi gali sabse badnaam hai.",
   "cap": "Par ab wahi gali sabse badnaam hai."
  },
  {
   "id": "r2",
   "group": "g6",
   "start": 30.239,
   "end": 34.719,
   "text": "Aath mahine mein 1400 ki 81 percent calls ignore hui, 1600 ki 79.",
   "cap": "Aath mahine mein 1400 ki 81 percent calls ignore hui, 1600 ki 79."
  },
  {
   "id": "r3",
   "group": "g7",
   "start": 35.244,
   "end": 41.361,
   "text": "Aur Truecaller us gali ko spam bol bhi nahi sakta. Bol sakta hai: \"Frequently Blocked\". Yaani spam ka sabhya naam.",
   "cap": "Aur Truecaller us gali ko spam bol bhi nahi sakta. Bol sakta hai: \"Frequently Blocked\". Yaani spam ka sabhya naam."
  },
  {
   "id": "f1",
   "group": "g8",
   "start": 41.948,
   "end": 45.507,
   "text": "Aur jo sach mein fraud hai, woh bhi bolta hai: bank, police, payment app.",
   "cap": "Aur jo sach mein fraud hai, woh bhi bolta hai: bank, police, payment app."
  },
  {
   "id": "f2",
   "group": "g8",
   "start": 45.267,
   "end": 47.067,
   "text": "770 crore fraud calls.",
   "cap": "770 crore fraud calls."
  },
  {
   "id": "f3",
   "group": "g9",
   "start": 47.761,
   "end": 52.783,
   "text": "Ek call ka average dedh minute. Blocking se roz lagbhag 247 saal ka time bacha. Roz.",
   "cap": "Ek call ka average dedh minute. Blocking se roz lagbhag 247 saal ka time bacha. Roz."
  },
  {
   "id": "d1",
   "group": "g10",
   "start": 53.338,
   "end": 59.287,
   "text": "Mere ghar mein har unknown call papa ke liye baat karne ka mauka hai. Aur scammer ko wahi chahiye: koi jo phone rakhna na jaane.",
   "cap": "Mere ghar mein har unknown call papa ke liye baat karne ka mauka hai. Aur scammer ko wahi chahiye: koi jo phone rakhna na jaane."
  },
  {
   "id": "x1",
   "group": "g11",
   "start": 59.953,
   "end": 66.55,
   "text": "18 September ko TRAI ne kaha: spam report karwane wale apps woh reports telecom ke platform ko bhejenge.",
   "cap": "18 September ko TRAI ne kaha: spam report karwane wale apps woh reports telecom ke platform ko bhejenge."
  },
  {
   "id": "x2",
   "group": "g11",
   "start": 66.15,
   "end": 67.95,
   "text": "Bina bataye robocall seedha spam.",
   "cap": "Bina bataye robocall seedha spam."
  },
  {
   "id": "x3",
   "group": "g12",
   "start": 68.557,
   "end": 73.259,
   "text": "Aur machine ki call par 5 paise per minute tak charge. Spam ke liye bhi ab call rate.",
   "cap": "Aur machine ki call par 5 paise per minute tak charge. Spam ke liye bhi ab call rate."
  },
  {
   "id": "x4",
   "group": "g13",
   "start": 73.758,
   "end": 78.002,
   "text": "Par kaam karega? Abhi koi nahi jaanta. Truecaller ise anti-competitive bolta hai.",
   "cap": "Par kaam karega? Abhi koi nahi jaanta. Truecaller ise anti-competitive bolta hai."
  },
  {
   "id": "c1",
   "group": "g14",
   "start": 78.636,
   "end": 82.757,
   "text": "Toh agli baar \"loan chahiye?\" aaye, yaad rakhna: us loan ko ab declare karna padega.",
   "cap": "Toh agli baar \"loan chahiye?\" aaye, yaad rakhna: us loan ko ab declare karna padega."
  },
  {
   "id": "cta",
   "group": "g15",
   "start": 83.376,
   "end": 90.117,
   "text": "Yeh us dost ko bhejiye jo kehta hai \"main to kabhi uthata hi nahi\". Like, share aur subscribe karein, Sandesh Explains.",
   "cap": "Yeh us dost ko bhejiye jo kehta hai \"main to kabhi uthata hi nahi\". Like, share aur subscribe karein, Sandesh Explains."
  }
 ],
