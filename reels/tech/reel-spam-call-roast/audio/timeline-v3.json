{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 4.596,
   "text": "Dopahar ke do bajkar saintalis minute. Aap ghar mein ho. Darwaze ki ghanti bajti hai.",
   "cap": "Dopahar ke do bajkar saintalis minute. Aap ghar mein ho. Darwaze ki ghanti bajti hai."
  },
  {
   "id": "h2",
   "group": "g1",
   "start": 4.256,
   "end": 7.476,
   "text": "Bahar ek aadmi: \"Sir, loan chahiye?\" Aapne loan maanga hi nahi tha.",
   "cap": "Bahar ek aadmi: \"Sir, loan chahiye?\" Aapne loan maanga hi nahi tha."
  },
  {
   "id": "h3",
   "group": "g2",
   "start": 8.558,
   "end": 9.639,
   "text": "Loan ne aapko dhoondha.",
   "cap": "Loan ne aapko dhoondha."
  },
  {
   "id": "a1",
   "group": "g3",
   "start": 10.231,
   "end": 13.959,
   "text": "Samajh lo, aapka phone number aapke ghar ki ghanti hai. Koi bhi baja sakta hai.",
   "cap": "Samajh lo, aapka phone number aapke ghar ki ghanti hai. Koi bhi baja sakta hai."
  },
  {
   "id": "a2",
   "group": "g3",
   "start": 13.619,
   "end": 18.139,
   "text": "Truecaller ke apne users ki ghanti pichle saal lagbhag 42 arab baar baji.",
   "cap": "Truecaller ke apne users ki ghanti pichle saal lagbhag 42 arab baar baji."
  },
  {
   "id": "a3",
   "group": "g4",
   "start": 18.806,
   "end": 21.573,
   "text": "Yaani mahine ke lagbhag das baar, mere rough hisaab se.",
   "cap": "Yaani mahine ke lagbhag das baar, mere rough hisaab se."
  },
  {
   "id": "t1",
   "group": "g5",
   "start": 22.061,
   "end": 28.107,
   "text": "Sarkar ne socha: saare salesman ek hi gali mein khade ho jaayein. Us gali ka number 1400, aur service walon ka 1600.",
   "cap": "Sarkar ne socha: saare salesman ek hi gali mein khade ho jaayein. Us gali ka number 1400, aur service walon ka 1600."
  },
  {
   "id": "t2",
   "group": "g5",
   "start": 27.747,
   "end": 31.627,
   "text": "Ab ghanti baje, to pata chalega: yeh gali se aaya hai, yaani dukaan.",
   "cap": "Ab ghanti baje, to pata chalega: yeh gali se aaya hai, yaani dukaan."
  },
  {
   "id": "r1",
   "group": "g6",
   "start": 32.187,
   "end": 37.631,
   "text": "Par hum bhi chalaak hain. Jis gali ka naam hi dukaan, wahan se ghanti aaye to hum darwaza kholte hi nahi.",
   "cap": "Par hum bhi chalaak hain. Jis gali ka naam hi dukaan, wahan se ghanti aaye to hum darwaza kholte hi nahi."
  },
  {
   "id": "r2",
   "group": "g6",
   "start": 37.111,
   "end": 43.791,
   "text": "Truecaller ke CEO ke mutabik aath mahine mein 1400 ki 81 percent ghantiyan ignore hui, aur 1600 ki 79.",
   "cap": "Truecaller ke CEO ke mutabik aath mahine mein 1400 ki 81 percent ghantiyan ignore hui, aur 1600 ki 79."
  },
  {
   "id": "w1",
   "group": "g7",
   "start": 44.326,
   "end": 48.463,
   "text": "Aur mohalle ka chowkidaar, Truecaller, us gali ko spam bol bhi nahi sakta.",
   "cap": "Aur mohalle ka chowkidaar, Truecaller, us gali ko spam bol bhi nahi sakta."
  },
  {
   "id": "w2",
   "group": "g7",
   "start": 48.003,
   "end": 52.223,
   "text": "Bas itna likh sakta hai: \"Frequently Blocked\". Yaani spam ka sabhya naam.",
   "cap": "Bas itna likh sakta hai: \"Frequently Blocked\". Yaani spam ka sabhya naam."
  },
  {
   "id": "f1",
   "group": "g8",
   "start": 52.802,
   "end": 56.265,
   "text": "Kuch ghantiyan to seedha dhokha hoti hain: bank, police, payment app bankar.",
   "cap": "Kuch ghantiyan to seedha dhokha hoti hain: bank, police, payment app bankar."
  },
  {
   "id": "f2",
   "group": "g8",
   "start": 55.745,
   "end": 59.205,
   "text": "Sat sau sattar crore aisi ghantiyan, Truecaller ke hisaab se.",
   "cap": "Sat sau sattar crore aisi ghantiyan, Truecaller ke hisaab se."
  },
  {
   "id": "x1",
   "group": "g9",
   "start": 59.813,
   "end": 62.859,
   "text": "Atharah September ko TRAI ne mohalle ke gate par teen niyam lagaye.",
   "cap": "Atharah September ko TRAI ne mohalle ke gate par teen niyam lagaye."
  },
  {
   "id": "x2",
   "group": "g9",
   "start": 62.539,
   "end": 67.819,
   "text": "Ek: chowkidaar ke paas jo shikayatein aati hain, woh telecom ke platform ko bhi bhejni hongi.",
   "cap": "Ek: chowkidaar ke paas jo shikayatein aati hain, woh telecom ke platform ko bhi bhejni hongi."
  },
  {
   "id": "x3",
   "group": "g10",
   "start": 68.463,
   "end": 71.248,
   "text": "Do: robot se aayi call bina bataye aayi, to seedhe spam.",
   "cap": "Do: robot se aayi call bina bataye aayi, to seedhe spam."
  },
  {
   "id": "x4",
   "group": "g10",
   "start": 70.708,
   "end": 74.248,
   "text": "Teen: machine ki call par paanch paise per minute tak ka toll.",
   "cap": "Teen: machine ki call par paanch paise per minute tak ka toll."
  },
  {
   "id": "x5",
   "group": "g11",
   "start": 74.808,
   "end": 79.017,
   "text": "Par kaam karega? Abhi koi nahi jaanta. Truecaller ise anti-competitive bolta hai.",
   "cap": "Par kaam karega? Abhi koi nahi jaanta. Truecaller ise anti-competitive bolta hai."
  },
  {
   "id": "c1",
   "group": "g12",
   "start": 79.653,
   "end": 85.057,
   "text": "Toh agli baar darwaze par \"loan chahiye?\" sunai de, yaad rakhna: us loan ko ab apna naam batana padega.",
   "cap": "Toh agli baar darwaze par \"loan chahiye?\" sunai de, yaad rakhna: us loan ko ab apna naam batana padega."
  },
  {
   "id": "cta",
   "group": "g13",
   "start": 85.545,
   "end": 92.025,
   "text": "Yeh us dost ko bhejiye jo kehta hai \"main to kabhi uthata hi nahi\". Like, share aur subscribe karein, Sandesh Explains.",
   "cap": "Yeh us dost ko bhejiye jo kehta hai \"main to kabhi uthata hi nahi\". Like, share aur subscribe karein, Sandesh Explains."
  }
 ],
