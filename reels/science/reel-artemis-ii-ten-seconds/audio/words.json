 "end": 64.324,
 "provisional": [],
 "B": {
  "s1": "एक अप्रैल की शाम। एक रॉकेट, छह कैमरे, एक ही पल।",
  "s2": "ये आर्टेमिस दो है। पचास साल से ज़्यादा बाद, इंसान फिर चाँद की तरफ़।",
  "s3": "देखिए, दस सेकंड, असली समय में।",
  "s4": "छह कैमरे एक हो गए। आठ मिनट बाद पहला स्टेज अलग हुआ।",
  "s5": "नौ दिन, एक घंटा, बत्तीस मिनट बाद, ओरियन प्रशांत महासागर में उतरा, सैन डिएगो के पास।",
  "s6": "बीच में चार लोग पृथ्वी से इतनी दूर गए, जितनी पहले कोई इंसान नहीं गया। क़रीब चार लाख सात हज़ार किलोमीटर। प्रेस रिपोर्ट्स के मुताबिक़।",
  "s7": "पर उतरे नहीं। सिर्फ़ चाँद का चक्कर।",
  "s8": "अगली फ़्लाइट, आर्टेमिस तीन, दो हज़ार सत्ताईस में: वो भी चाँद पर नहीं जाएगी। धरती के पास लैंडर से डॉकिंग का टेस्ट।",
  "s9": "उतरना आर्टेमिस चार में है: दो हज़ार अट्ठाईस की शुरुआत, नासा के मुताबिक़। तारीख़ें बदल सकती हैं।",
  "s10": "ऐसी असली फ़ुटेज वाली कहानियाँ चाहिए? फॉलो और शेयर कीजिए, नर्डलॉजिक डॉट सी ओ को।"
 }
}