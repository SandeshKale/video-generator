{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 3.202,
   "text": "Ek April ki shaam. Ek rocket, chhe camere, ek hi pal.",
   "cap": "Ek April ki shaam. Ek rocket, chhe camere, ek hi pal."
  },
  {
   "id": "s2",
   "group": "g1",
   "start": 3.122,
   "end": 6.882,
   "text": "Ye Artemis Do hai. Pachaas saal se zyada baad, insaan phir Chaand ki taraf.",
   "cap": "Ye Artemis Do hai. Pachaas saal se zyada baad, insaan phir Chaand ki taraf."
  },
  {
   "id": "s3",
   "group": "g2",
   "start": 7.374,
   "end": 9.113,
   "text": "Dekhiye, das second, asli samay mein.",
   "cap": "Dekhiye, das second, asli samay mein."
  },
  {
   "id": "s4",
   "group": "g3",
   "start": 23.66,
   "end": 27.057,
   "text": "Chhe camere ek ho gaye. Aath minute baad pehla stage alag hua.",
   "cap": "Chhe camere ek ho gaye. Aath minute baad pehla stage alag hua."
  },
  {
   "id": "s5",
   "group": "g4",
   "start": 27.531,
   "end": 32.493,
   "text": "Nau din, ek ghanta, battees minute baad, Orion Pacific mein utra, San Diego ke paas.",
   "cap": "Nau din, ek ghanta, battees minute baad, Orion Pacific mein utra, San Diego ke paas."
  },
  {
   "id": "s6",
   "group": "g5",
   "start": 33.015,
   "end": 40.697,
   "text": "Beech mein chaar log Earth se itni door gaye, jitni pehle koi insaan nahi gaya. Kareeb 4 lakh 7 hazaar kilometre. Press reports ke mutabik.",
   "cap": "Beech mein chaar log Earth se itni door gaye, jitni pehle koi insaan nahi gaya. Kareeb 4 lakh 7 hazaar kilometre. Press reports ke mutabik."
  },
  {
   "id": "s7",
   "group": "g6",
   "start": 41.215,
   "end": 43.377,
   "text": "Par utre nahi. Sirf Chaand ka chakkar.",
   "cap": "Par utre nahi. Sirf Chaand ka chakkar."
  },
  {
   "id": "s8",
   "group": "g7",
   "start": 43.844,
   "end": 50.342,
   "text": "Agli flight, Artemis Teen, 2027 mein: wo bhi Chaand par nahi jayegi. Dharti ke paas lander se docking ka test.",
   "cap": "Agli flight, Artemis Teen, 2027 mein: wo bhi Chaand par nahi jayegi. Dharti ke paas lander se docking ka test."
  },
  {
   "id": "s9",
   "group": "g8",
   "start": 50.848,
   "end": 56.33,
   "text": "Utarna Artemis Chaar mein hai: 2028 ki shuruaat, NASA ke mutabik. Dates badal sakti hain.",
   "cap": "Utarna Artemis Chaar mein hai: 2028 ki shuruaat, NASA ke mutabik. Dates badal sakti hain."
  },
  {
   "id": "s10",
   "group": "g9",
   "start": 56.814,
   "end": 61.499,
   "text": "Aisi asli footage wali kahaniyan chahiye? Follow aur share kijiye, nerdlogic.co ko.",
   "cap": "Aisi asli footage wali kahaniyan chahiye? Follow aur share kijiye, nerdlogic.co ko."
  }
 ],
