{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 3.179,
   "text": "Yeh tilak kisi insaan ne nahi lagaya. Ise sooraj ne lagaya hai!",
   "cap": "Yeh tilak kisi insaan ne nahi lagaya. Ise sooraj ne lagaya hai!"
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 4.01,
   "end": 6.915,
   "text": "Ayodhya mein, Ram Navami ki dopahar, Ram Lalla ke maathe par.",
   "cap": "Ayodhya mein, Ram Navami ki dopahar, Ram Lalla ke maathe par."
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 7.493,
   "end": 9.013,
   "text": "Na bulb, na taar.",
   "cap": "Na bulb, na taar."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 9.89,
   "end": 14.276,
   "text": "Aapne dekha hoga: chhat ke chhed se dhoop ki ek lakeer aati hai, aur usme dhool naachti hai.",
   "cap": "Aapne dekha hoga: chhat ke chhed se dhoop ki ek lakeer aati hai, aur usme dhool naachti hai."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 14.81,
   "end": 15.618,
   "text": "Yeh wahi dhoop hai.",
   "cap": "Yeh wahi dhoop hai."
  },
  {
   "id": "s6",
   "group": "g5",
   "start": 15.398,
   "end": 17.438,
   "text": "Bas, ise teen manzil neeche laana tha.",
   "cap": "Bas, ise teen manzil neeche laana tha."
  },
  {
   "id": "s7",
   "group": "g6",
   "start": 18.044,
   "end": 22.068,
   "text": "Mushkil yeh hai: garbhagriha sabse neeche hai, aur upar pathar ki teen manzilein.",
   "cap": "Mushkil yeh hai: garbhagriha sabse neeche hai, aur upar pathar ki teen manzilein."
  },
  {
   "id": "s8",
   "group": "g7",
   "start": 22.617,
   "end": 24.762,
   "text": "Aur dopahar ka sooraj, seedha sir ke upar.",
   "cap": "Aur dopahar ka sooraj, seedha sir ke upar."
  },
  {
   "id": "s9",
   "group": "g8",
   "start": 25.479,
   "end": 27.367,
   "text": "Toh vaigyanikon ne ek periscope banaya.",
   "cap": "Toh vaigyanikon ne ek periscope banaya."
  },
  {
   "id": "s10",
   "group": "g9",
   "start": 27.918,
   "end": 30.521,
   "text": "Bachpan mein aaine se deewar par dhoop chamkaayi thi na?",
   "cap": "Bachpan mein aaine se deewar par dhoop chamkaayi thi na?"
  },
  {
   "id": "s11",
   "group": "g9",
   "start": 30.041,
   "end": 31.281,
   "text": "Bilkul wahi.",
   "cap": "Bilkul wahi."
  },
  {
   "id": "s12",
   "group": "g10",
   "start": 31.736,
   "end": 36.16,
   "text": "Chhat par pehla aaina dhoop pakadta hai, aur use peetal ke pipe mein, neeche bhej deta hai.",
   "cap": "Chhat par pehla aaina dhoop pakadta hai, aur use peetal ke pipe mein, neeche bhej deta hai."
  },
  {
   "id": "s13",
   "group": "g11",
   "start": 36.68,
   "end": 37.962,
   "text": "Pipe ke andar lens hain.",
   "cap": "Pipe ke andar lens hain."
  },
  {
   "id": "s14",
   "group": "g11",
   "start": 37.602,
   "end": 39.822,
   "text": "Wahi lens, jisse hum kaagaz jalaate the.",
   "cap": "Wahi lens, jisse hum kaagaz jalaate the."
  },
  {
   "id": "s15",
   "group": "g12",
   "start": 40.428,
   "end": 43.134,
   "text": "Isliye sabse upar, ek sheesha garmi rok leta hai.",
   "cap": "Isliye sabse upar, ek sheesha garmi rok leta hai."
  },
  {
   "id": "s16",
   "group": "g13",
   "start": 43.643,
   "end": 47.363,
   "text": "Lens roshni ko sikodte hain, aur aakhri aaina use maathe par rakh deta hai.",
   "cap": "Lens roshni ko sikodte hain, aur aakhri aaina use maathe par rakh deta hai."
  },
  {
   "id": "s17",
   "group": "g14",
   "start": 47.866,
   "end": 49.514,
   "text": "Sirf 58 millimetre.",
   "cap": "Sirf 58 millimetre."
  },
  {
   "id": "s18",
   "group": "g15",
   "start": 50.333,
   "end": 52.242,
   "text": "Par asli pareshani ab shuru hoti hai.",
   "cap": "Par asli pareshani ab shuru hoti hai."
  },
  {
   "id": "s19",
   "group": "g16",
   "start": 52.722,
   "end": 54.925,
   "text": "2024 mein, tilak bilkul sahi laga.",
   "cap": "2024 mein, tilak bilkul sahi laga."
  },
  {
   "id": "s20",
   "group": "g17",
   "start": 55.536,
   "end": 59.258,
   "text": "Agle saal, wahi aaina, wahi jagah... aur roshni maathe se hat gayi.",
   "cap": "Agle saal, wahi aaina, wahi jagah... aur roshni maathe se hat gayi."
  },
  {
   "id": "s21",
   "group": "g17",
   "start": 58.918,
   "end": 59.258,
   "text": "Kyun?",
   "cap": "Kyun?"
  },
  {
   "id": "s22",
   "group": "g18",
   "start": 60.209,
   "end": 61.996,
   "text": "Kyunki Ram Navami chaand se chalti hai.",
   "cap": "Kyunki Ram Navami chaand se chalti hai."
  },
  {
   "id": "s23",
   "group": "g18",
   "start": 61.836,
   "end": 64.396,
   "text": "Jaise Holi aur Diwali, har saal alag taareekh.",
   "cap": "Jaise Holi aur Diwali, har saal alag taareekh."
  },
  {
   "id": "s24",
   "group": "g19",
   "start": 64.829,
   "end": 67.231,
   "text": "Aur taareekh badli, toh sooraj ki oonchai bhi badli.",
   "cap": "Aur taareekh badli, toh sooraj ki oonchai bhi badli."
  },
  {
   "id": "s25",
   "group": "g20",
   "start": 67.775,
   "end": 70.536,
   "text": "Kisaan jaanta hai: sardi mein parchhai lambi, garmi mein chhoti.",
   "cap": "Kisaan jaanta hai: sardi mein parchhai lambi, garmi mein chhoti."
  },
  {
   "id": "s26",
   "group": "g21",
   "start": 71.235,
   "end": 74.22,
   "text": "Toh Bengaluru ke vaigyanikon ne, 19 saal ka hisaab lagaya.",
   "cap": "Toh Bengaluru ke vaigyanikon ne, 19 saal ka hisaab lagaya."
  },
  {
   "id": "s27",
   "group": "g22",
   "start": 74.745,
   "end": 77.431,
   "text": "19 saal baad, chaand aur sooraj phir saath aa jaate hain.",
   "cap": "19 saal baad, chaand aur sooraj phir saath aa jaate hain."
  },
  {
   "id": "s28",
   "group": "g23",
   "start": 77.961,
   "end": 80.383,
   "text": "Isliye pehle aaine ki, 19 settings hain.",
   "cap": "Isliye pehle aaine ki, 19 settings hain."
  },
  {
   "id": "s29",
   "group": "g24",
   "start": 80.959,
   "end": 86.151,
   "text": "Saal mein ek baar, ek aadmi upar chadhta hai, aur radio ki tuning ki tarah, aaina zara sa ghumaata hai.",
   "cap": "Saal mein ek baar, ek aadmi upar chadhta hai, aur radio ki tuning ki tarah, aaina zara sa ghumaata hai."
  },
  {
   "id": "s30",
   "group": "g25",
   "start": 86.922,
   "end": 88.848,
   "text": "Aur tilak sirf kuch minute rehta hai.",
   "cap": "Aur tilak sirf kuch minute rehta hai."
  },
  {
   "id": "s31",
   "group": "g26",
   "start": 89.294,
   "end": 93.635,
   "text": "Kyunki dharti ghoom rahi hai, aur sooraj 2 minute mein, apni hi chaudaai jitna khisak jaata hai.",
   "cap": "Kyunki dharti ghoom rahi hai, aur sooraj 2 minute mein, apni hi chaudaai jitna khisak jaata hai."
  },
  {
   "id": "s32",
   "group": "g27",
   "start": 94.348,
   "end": 95.227,
   "text": "Baadal aa gaya?",
   "cap": "Baadal aa gaya?"
  },
  {
   "id": "s33",
   "group": "g27",
   "start": 94.887,
   "end": 96.407,
   "text": "Toh us saal, tilak nahi.",
   "cap": "Toh us saal, tilak nahi."
  },
  {
   "id": "s34",
   "group": "g28",
   "start": 97.177,
   "end": 98.277,
   "text": "Na bijli, na motor.",
   "cap": "Na bijli, na motor."
  },
  {
   "id": "s35",
   "group": "g28",
   "start": 97.957,
   "end": 100.377,
   "text": "Bas aaine, peetal, ganit, aur khula aasmaan.",
   "cap": "Bas aaine, peetal, ganit, aur khula aasmaan."
  },
  {
   "id": "s36",
   "group": "g29",
   "start": 101.012,
   "end": 104.154,
   "text": "Agli baar chhat se dhoop ki lakeer dikhe, toh yeh yaad kijiyega.",
   "cap": "Agli baar chhat se dhoop ki lakeer dikhe, toh yeh yaad kijiyega."
  },
  {
   "id": "s37",
   "group": "g30",
   "start": 104.692,
   "end": 106.93,
   "text": "Share aur follow karein, nerdlogic.co",
   "cap": "Share aur follow karein, nerdlogic.co"
  }
 ],
