 "B": {
  "s1": "यह तिलक किसी इंसान ने नहीं लगाया। इसे सूरज ने लगाया है!",
  "s2": "अयोध्या में, राम नवमी की दोपहर, राम लला के माथे पर।",
  "s3": "ना बल्ब, ना तार।",
  "s4": "आपने देखा होगा: छत के छेद से धूप की एक लकीर आती है, और उसमें धूल नाचती है।",
  "s5": "यह वही धूप है।",
  "s6": "बस, इसे तीन मंज़िल नीचे लाना था।",
  "s7": "मुश्किल यह है: गर्भगृह सबसे नीचे है, और ऊपर पत्थर की तीन मंज़िलें।",
  "s8": "और दोपहर का सूरज, सीधा सिर के ऊपर।",
  "s9": "तो वैज्ञानिकों ने एक पेरिस्कोप बनाया।",
  "s10": "बचपन में आईने से दीवार पर धूप चमकाई थी ना?",
  "s11": "बिल्कुल वही।",
  "s12": "छत पर पहला आईना धूप पकड़ता है, और उसे पीतल के पाइप में, नीचे भेज देता है।",
  "s13": "पाइप के अंदर लेंस हैं।",
  "s14": "वही लेंस, जिससे हम कागज़ जलाते थे।",
  "s15": "इसलिए सबसे ऊपर, एक शीशा गर्मी रोक लेता है।",
  "s16": "लेंस रोशनी को सिकोड़ते हैं, और आख़िरी आईना उसे माथे पर रख देता है।",
  "s17": "सिर्फ़ अट्ठावन मिलीमीटर।",
  "s18": "पर असली परेशानी अब शुरू होती है।",
  "s19": "दो हज़ार चौबीस में, तिलक बिल्कुल सही लगा।",
  "s20": "अगले साल, वही आईना, वही जगह... और रोशनी माथे से हट गई।",
  "s21": "क्यों?",
  "s22": "क्योंकि राम नवमी चाँद से चलती है।",
  "s23": "जैसे होली और दिवाली, हर साल अलग तारीख़।",
  "s24": "और तारीख़ बदली, तो सूरज की ऊँचाई भी बदली।",
  "s25": "किसान जानता है: सर्दी में परछाई लंबी, गर्मी में छोटी।",
  "s26": "तो बेंगलुरु के वैज्ञानिकों ने, उन्नीस साल का हिसाब लगाया।",
  "s27": "उन्नीस साल बाद, चाँद और सूरज फिर साथ आ जाते हैं।",
  "s28": "इसलिए पहले आईने की, उन्नीस सेटिंग्स हैं।",
  "s29": "साल में एक बार, एक आदमी ऊपर चढ़ता है, और रेडियो की ट्यूनिंग की तरह, आईना ज़रा सा घुमाता है।",
  "s30": "और तिलक सिर्फ़ कुछ मिनट रहता है।",
  "s31": "क्योंकि धरती घूम रही है, और सूरज दो मिनट में, अपनी ही चौड़ाई जितना खिसक जाता है।",
  "s32": "बादल आ गया?",
  "s33": "तो उस साल, तिलक नहीं।",
  "s34": "ना बिजली, ना मोटर।",
  "s35": "बस आईने, पीतल, गणित, और खुला आसमान।",
  "s36": "अगली बार छत से धूप की लकीर दिखे, तो यह याद कीजिएगा।",
  "s37": "शेयर और फ़ॉलो करें, नर्डलॉजिक डॉट सी ओ।"
 }
}