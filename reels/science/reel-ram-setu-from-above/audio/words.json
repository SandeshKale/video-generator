 "B": {
  "h1": "रामायण फ़िल्म दिवाली पे आ रही है, और उसका सबसे मशहूर सेट पीस समंदर के ऊपर एक पुल है। पर असली समंदर में एक असली रेत-पट्टी है, और उसका निन्यानवे दशमलव नौ आठ परसेंट हिस्सा पानी के नीचे है।",
  "h2": "सैटेलाइट ने उसे नापा है। तो सवाल ये है: एक सैटेलाइट असल में क्या बता सकता है, और क्या नहीं?",
  "p1": "ऊपर से देखो तो रामेश्वरम और मन्नार के बीच एक हल्की सी पट्टी दिखती है। यूरोप के सेंटिनल टू सैटेलाइट की तस्वीर में भी यही पट्टी दिखती है।",
  "b1": "पर ये पट्टी ज़्यादातर पानी के नीचे है। स्टडी के मुताबिक समंदर की सतह के ऊपर सिर्फ़ शून्य दशमलव शून्य दो परसेंट है।",
  "b2": "तो पानी के नीचे का नक्शा बनता कैसे है? लेज़र से।",
  "m1": "नासा का आइसैट टू सैटेलाइट हरे लेज़र की किरणें नीचे फेंकता है। रोशनी समंदर की तली तक जाती है और लौटती है, लगभग चालीस मीटर गहराई तक।",
  "m2": "इसरो के वैज्ञानिकों ने दो हज़ार अठारह से दो हज़ार तेईस तक का डेटा लिया: लगभग दो लाख फ़ोटॉन, और दस मीटर की रेज़ोल्यूशन का नक्शा।",
  "l1": "अब एक अजीब बात। कहीं अड़तालीस किलोमीटर लिखा मिलता है, कहीं उनतीस। स्टडी ने धनुषकोडी से तलाईमन्नार तक की शोल्स की ज़ंजीर नापी: लगभग उनतीस किलोमीटर।",
  "l2": "शायद नंबर इसलिए अलग हैं कि नापने के छोर अलग हैं। ये मेरी समझ है, किसी सोर्स ने ये नहीं कहा।",
  "r1": "नक्शा और कुछ दिखाता है। ज़ंजीर के दोनों तरफ़ लगभग डेढ़ किलोमीटर तक तल बहुत ऊबड़-खाबड़ है, और गहराई अचानक बदलती है।",
  "r2": "ढाल भी दोनों तरफ़ एक जैसी नहीं। स्टडी कहती है कि मन्नार की खाड़ी से ज़्यादा मिट्टी आती है, पाल्क स्ट्रेट से कम। यानी समंदर ने इसे आकार दिया है।",
  "j1": "नक्शा ये भी दिखाता है कि ये धनुषकोडी और तलाईमन्नार का समंदर के नीचे का सिलसिला है।",
  "e1": "एक ज़रूरी बात: ये स्टडी आकार, गहराई और मात्रा नापती है, लगभग एक घन किलोमीटर। ये नहीं बताती कि इसे किसने बनाया, और किसी कहानी की बात भी नहीं करती।",
  "f1": "तो फ़िल्म देखते वक़्त याद रखना: पुल कहानी का है, पर रेत-पट्टी असली है। लगभग उनतीस किलोमीटर, निन्यानवे दशमलव नौ आठ परसेंट पानी के नीचे, लेज़र से नापी हुई।",
  "cta": "ये उस दोस्त को भेजिए जो हर बात पर बहस करता है। लाइक, शेयर और सब्सक्राइब करें, संदेश एक्सप्लेन्स को।"
 }
