{
 "sentences": [
  {
   "id": "h1",
   "group": "g1",
   "start": 0.0,
   "end": 10.406,
   "text": "Ramayana film Diwali pe aa rahi hai (reported), aur uska sabse mashhoor set piece samundar ke upar ek pul hai. Par asli samundar mein ek asli ret-patti hai, aur uska 99.98 percent hissa paani ke neeche hai.",
   "cap": "Ramayana film Diwali pe aa rahi hai (reported), aur uska sabse mashhoor set piece samundar ke upar ek pul hai. Par asli samundar mein ek asli ret-patti hai, aur uska 99.98 percent hissa paani ke neeche hai."
  },
  {
   "id": "h2",
   "group": "g1",
   "start": 10.086,
   "end": 14.106,
   "text": "Satellite ne use naapa hai. To sawaal yeh hai: ek satellite asal mein kya bata sakta hai, aur kya nahi?",
   "cap": "Satellite ne use naapa hai. To sawaal yeh hai: ek satellite asal mein kya bata sakta hai, aur kya nahi?"
  },
  {
   "id": "p1",
   "group": "g2",
   "start": 15.151,
   "end": 21.796,
   "text": "Upar se dekho to Rameswaram aur Mannar ke beech ek halki si patti dikhti hai. Europe ke Sentinel-2 satellite ki tasveer mein bhi yahi patti dikhti hai.",
   "cap": "Upar se dekho to Rameswaram aur Mannar ke beech ek halki si patti dikhti hai. Europe ke Sentinel-2 satellite ki tasveer mein bhi yahi patti dikhti hai."
  },
  {
   "id": "b1",
   "group": "g3",
   "start": 22.768,
   "end": 28.489,
   "text": "Par yeh patti zyadatar paani ke neeche hai. Study ke mutabik samundar ki satah ke upar sirf 0.02 percent hai.",
   "cap": "Par yeh patti zyadatar paani ke neeche hai. Study ke mutabik samundar ki satah ke upar sirf 0.02 percent hai."
  },
  {
   "id": "b2",
   "group": "g3",
   "start": 28.409,
   "end": 30.669,
   "text": "To paani ke neeche ka naksha banta kaise hai? Laser se.",
   "cap": "To paani ke neeche ka naksha banta kaise hai? Laser se."
  },
  {
   "id": "m1",
   "group": "g4",
   "start": 31.443,
   "end": 37.945,
   "text": "NASA ka ICESat-2 satellite hare laser ki kirnein neeche phenkta hai. Roshni samundar ki tali tak jaati hai aur lautti hai, lagbhag chalis meter gehrai tak.",
   "cap": "NASA ka ICESat-2 satellite hare laser ki kirnein neeche phenkta hai. Roshni samundar ki tali tak jaati hai aur lautti hai, lagbhag chalis meter gehrai tak."
  },
  {
   "id": "m2",
   "group": "g5",
   "start": 38.773,
   "end": 44.936,
   "text": "ISRO ke vaigyanikon ne 2018 se 2023 tak ka data liya: lagbhag do lakh photon, aur dus meter ki resolution ka naksha.",
   "cap": "ISRO ke vaigyanikon ne 2018 se 2023 tak ka data liya: lagbhag do lakh photon, aur dus meter ki resolution ka naksha."
  },
  {
   "id": "l1",
   "group": "g6",
   "start": 45.893,
   "end": 53.46,
   "text": "Ab ek ajeeb baat. Kahin 48 kilometre likha milta hai, kahin 29. Study ne Dhanushkodi se Talaimannar tak ki shoals ki zanjeer naapi: lagbhag 29 kilometre.",
   "cap": "Ab ek ajeeb baat. Kahin 48 kilometre likha milta hai, kahin 29. Study ne Dhanushkodi se Talaimannar tak ki shoals ki zanjeer naapi: lagbhag 29 kilometre."
  },
  {
   "id": "l2",
   "group": "g7",
   "start": 54.298,
   "end": 58.626,
   "text": "Shayad number isliye alag hain ki naapne ke chhor alag hain. Yeh meri samajh hai, kisi source ne yeh nahi kaha.",
   "cap": "Shayad number isliye alag hain ki naapne ke chhor alag hain. Yeh meri samajh hai, kisi source ne yeh nahi kaha."
  },
  {
   "id": "r1",
   "group": "g8",
   "start": 59.816,
   "end": 65.834,
   "text": "Naksha aur kuch dikhata hai. Zanjeer ke dono taraf lagbhag dedh kilometre tak tal bahut ubad-khabad hai, aur gehrai achanak badalti hai.",
   "cap": "Naksha aur kuch dikhata hai. Zanjeer ke dono taraf lagbhag dedh kilometre tak tal bahut ubad-khabad hai, aur gehrai achanak badalti hai."
  },
  {
   "id": "r2",
   "group": "g9",
   "start": 66.522,
   "end": 73.443,
   "text": "Dhaal bhi dono taraf ek jaisi nahi. Study kehti hai ki Mannar ki khaadi se zyada mitti aati hai, Palk Strait se kam. Yaani samundar ne ise aakaar diya hai.",
   "cap": "Dhaal bhi dono taraf ek jaisi nahi. Study kehti hai ki Mannar ki khaadi se zyada mitti aati hai, Palk Strait se kam. Yaani samundar ne ise aakaar diya hai."
  },
  {
   "id": "j1",
   "group": "g9",
   "start": 73.143,
   "end": 77.063,
   "text": "Naksha yeh bhi dikhata hai ki yeh Dhanushkodi aur Talaimannar ka samundar ke neeche ka silsila hai.",
   "cap": "Naksha yeh bhi dikhata hai ki yeh Dhanushkodi aur Talaimannar ka samundar ke neeche ka silsila hai."
  },
  {
   "id": "e1",
   "group": "g10",
   "start": 77.978,
   "end": 85.297,
   "text": "Ek zaroori baat: yeh study aakaar, gehrai aur matra naapti hai, lagbhag ek ghan kilometre. Yeh nahi batati ki ise kisne banaya, aur kisi kahani ki baat bhi nahi karti.",
   "cap": "Ek zaroori baat: yeh study aakaar, gehrai aur matra naapti hai, lagbhag ek ghan kilometre. Yeh nahi batati ki ise kisne banaya, aur kisi kahani ki baat bhi nahi karti."
  },
  {
   "id": "f1",
   "group": "g11",
   "start": 86.208,
   "end": 93.63,
   "text": "To film dekhte waqt yaad rakhna: pul kahani ka hai, par ret-patti asli hai. Yeh kareeb 29 kilometre lambi hai, aur 99.98 percent paani ke neeche hai.",
   "cap": "To film dekhte waqt yaad rakhna: pul kahani ka hai, par ret-patti asli hai. Yeh kareeb 29 kilometre lambi hai, aur 99.98 percent paani ke neeche hai."
  },
  {
   "id": "cta",
   "group": "g12",
   "start": 94.758,
   "end": 99.876,
   "text": "Yeh us dost ko bhejiye jo har baat par bahas karta hai. Like, share aur subscribe karein, Sandesh Explains.",
   "cap": "Yeh us dost ko bhejiye jo har baat par bahas karta hai. Like, share aur subscribe karein, Sandesh Explains."
  }
