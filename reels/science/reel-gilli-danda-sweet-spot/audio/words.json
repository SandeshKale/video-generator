 "provisional": [],
 "B": {
  "s1": "सोलह दिसंबर को आईपीएल की नीलामी है, और कुछ अनजान नाम करोड़पति बनेंगे। उनके बल्ले की फ़िज़िक्स, आपने गाँव की गली में पहले ही देख रखी है।",
  "s2": "गिल्ली को पत्थर पर तिरछा रखो। उसके किनारे पर डंडा मारो, और वो हवा में उछल जाती है।",
  "s3": "लेकिन अगर बीच में मारो? तो वो बस खिसकती है, उछलती नहीं। ताक़त वही थी, बस जगह बदल गई।",
  "s4": "इसे कहते हैं टॉर्क। ताक़त गुणा दूरी। केंद्र से जितना दूर मारो, उतना ज़्यादा घुमाव।",
  "s5": "अब बल्ले पर आओ। गेंद बल्ले पर कहीं भी लगे, बल्ला काँपता है। पर एक ख़ास जगह है, जहाँ काँपना लगभग रुक जाता है।",
  "s6": "बल्ले के सिरे से क़रीब पंद्रह सेंटीमीटर अंदर। इसे स्वीट स्पॉट कहते हैं। यहाँ गेंद लगे, तो हाथ को झटका नहीं लगता।",
  "s7": "किनारे पर लगी? तो काँपना सीधा हाथ तक आता है, और हाथ सुन्न।",
  "s8": "अभी सैयद मुश्ताक़ अली ट्रॉफ़ी चल रही है, और नीलामी से पहले कई लड़के अपना नाम बना रहे हैं।",
  "s9": "गिल्ली हो या करोड़ों का बल्ला, राज़ एक ही है: सही जगह पर मारो।",
  "s10": "आपने गिल्ली-डंडा खेला है? अपने गाँव का नाम लिखो। नर्डलॉजिक डॉट सी ओ को फ़ॉलो करो, और शेयर करो।"
 }
}