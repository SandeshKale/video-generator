{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 8.052,
   "text": "16 December ko IPL ki neelaami hai, aur kuch anjaan naam crorepati banenge. Unke bat ki physics, aapne gaon ki gali mein pehle hi dekh rakhi hai.",
   "cap": "16 December ko IPL ki neelaami hai, aur kuch anjaan naam crorepati banenge. Unke bat ki physics, aapne gaon ki gali mein pehle hi dekh rakhi hai."
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 8.758,
   "end": 13.579,
   "text": "Gilli ko patthar par tirchha rakho. Uske kinare par danda maaro, aur wo hawa mein uchhal jaati hai.",
   "cap": "Gilli ko patthar par tirchha rakho. Uske kinare par danda maaro, aur wo hawa mein uchhal jaati hai."
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 14.049,
   "end": 19.308,
   "text": "Lekin agar beech mein maaro? Wo bas khisakti hai, uchhalti nahi. Taaqat wahi thi, bas jagah badal gayi.",
   "cap": "Lekin agar beech mein maaro? Wo bas khisakti hai, uchhalti nahi. Taaqat wahi thi, bas jagah badal gayi."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 19.971,
   "end": 24.498,
   "text": "Ise kehte hain torque. Taaqat guna doori. Centre se jitna door maaro, utna zyada ghumaav.",
   "cap": "Ise kehte hain torque. Taaqat guna doori. Centre se jitna door maaro, utna zyada ghumaav."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 25.154,
   "end": 31.64,
   "text": "Ab bat par aao. Gend bat par kahin bhi lage, bat kaanpta hai. Par ek khaas jagah hai, jahan kaanpna lagbhag ruk jaata hai.",
   "cap": "Ab bat par aao. Gend bat par kahin bhi lage, bat kaanpta hai. Par ek khaas jagah hai, jahan kaanpna lagbhag ruk jaata hai."
  },
  {
   "id": "s6",
   "group": "g6",
   "start": 32.086,
   "end": 38.444,
   "text": "Bat ke sire se kareeb pandrah centimetre andar. Ise sweet spot kehte hain. Yahan gend lage, toh haath ko jhatka nahi lagta.",
   "cap": "Bat ke sire se kareeb pandrah centimetre andar. Ise sweet spot kehte hain. Yahan gend lage, toh haath ko jhatka nahi lagta."
  },
  {
   "id": "s7",
   "group": "g7",
   "start": 38.996,
   "end": 42.456,
   "text": "Kinare par lagi? Toh kaanpna seedha haath tak aata hai, aur haath sunn.",
   "cap": "Kinare par lagi? Toh kaanpna seedha haath tak aata hai, aur haath sunn."
  },
  {
   "id": "s8",
   "group": "g8",
   "start": 43.011,
   "end": 48.175,
   "text": "Abhi Syed Mushtaq Ali Trophy chal rahi hai, aur neelaami se pehle kai ladke apna naam bana rahe hain.",
   "cap": "Abhi Syed Mushtaq Ali Trophy chal rahi hai, aur neelaami se pehle kai ladke apna naam bana rahe hain."
  },
  {
   "id": "s9",
   "group": "g9",
   "start": 48.684,
   "end": 51.962,
   "text": "Gilli ho ya karodon ka bat, raaz ek hi hai: sahi jagah par maaro.",
   "cap": "Gilli ho ya karodon ka bat, raaz ek hi hai: sahi jagah par maaro."
  },
  {
   "id": "s10",
   "group": "g10",
   "start": 52.804,
   "end": 58.105,
   "text": "Aapne gilli-danda khela hai? Apne gaon ka naam likho. nerdlogic.co ko follow karo, aur share karo.",
   "cap": "Aapne gilli-danda khela hai? Apne gaon ka naam likho. nerdlogic.co ko follow karo, aur share karo."
  }
 ],
