{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 2.028,
   "text": "Film mein Jatayu ne Ravan ka rath tod diya.",
   "cap": "Film mein Jatayu ne Ravan ka rath tod diya."
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 2.362,
   "end": 4.808,
   "text": "Par ek sawaal: itna bada pakshi, ud bhi sakta hai?",
   "cap": "Par ek sawaal: itna bada pakshi, ud bhi sakta hai?"
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 5.609,
   "end": 7.136,
   "text": "Comment mein apna jawaab likhiye.",
   "cap": "Comment mein apna jawaab likhiye."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 7.774,
   "end": 10.476,
   "text": "Valmiki ne Jatayu ko gidhraj kaha: gidhon ka raja.",
   "cap": "Valmiki ne Jatayu ko gidhraj kaha: gidhon ka raja."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 11.051,
   "end": 13.833,
   "text": "Aur asli gidh, aaj bhi hamare aasmaan mein udta hai.",
   "cap": "Aur asli gidh, aaj bhi hamare aasmaan mein udta hai."
  },
  {
   "id": "s6",
   "group": "g6",
   "start": 14.355,
   "end": 16.458,
   "text": "Pankh: dhaai metre. Vazan: sirf chhe kilo.",
   "cap": "Pankh: dhaai metre. Vazan: sirf chhe kilo."
  },
  {
   "id": "s7",
   "group": "g7",
   "start": 17.088,
   "end": 19.991,
   "text": "Chhe kilo mein itne bade pankh? Chaliye, ise khol ke dekhte hain.",
   "cap": "Chhe kilo mein itne bade pankh? Chaliye, ise khol ke dekhte hain."
  },
  {
   "id": "s8",
   "group": "g8",
   "start": 20.514,
   "end": 21.525,
   "text": "Sabse upar, pankh.",
   "cap": "Sabse upar, pankh."
  },
  {
   "id": "s9",
   "group": "g8",
   "start": 21.145,
   "end": 24.765,
   "text": "Har pankh mein hazaaron baareek kaante hain, jo zip ki tarah jud jaate hain.",
   "cap": "Har pankh mein hazaaron baareek kaante hain, jo zip ki tarah jud jaate hain."
  },
  {
   "id": "s10",
   "group": "g9",
   "start": 25.554,
   "end": 26.734,
   "text": "Halka bhi, mazboot bhi.",
   "cap": "Halka bhi, mazboot bhi."
  },
  {
   "id": "s11",
   "group": "g10",
   "start": 27.311,
   "end": 30.536,
   "text": "Uske neeche, seene ki maaspeshi. Poore vazan ka lagbhag ek chauthai.",
   "cap": "Uske neeche, seene ki maaspeshi. Poore vazan ka lagbhag ek chauthai."
  },
  {
   "id": "s12",
   "group": "g11",
   "start": 31.171,
   "end": 32.418,
   "text": "Yahi iska engine hai.",
   "cap": "Yahi iska engine hai."
  },
  {
   "id": "s13",
   "group": "g12",
   "start": 33.039,
   "end": 34.94,
   "text": "Aur haddiyan? Andar se khokhli.",
   "cap": "Aur haddiyan? Andar se khokhli."
  },
  {
   "id": "s14",
   "group": "g13",
   "start": 35.441,
   "end": 38.084,
   "text": "Par beech mein tirchhi pattiyan hain, jaise pul ke girder.",
   "cap": "Par beech mein tirchhi pattiyan hain, jaise pul ke girder."
  },
  {
   "id": "s15",
   "group": "g14",
   "start": 38.622,
   "end": 40.686,
   "text": "Poora dhaancha, vazan ka sirf paanch pratishat.",
   "cap": "Poora dhaancha, vazan ka sirf paanch pratishat."
  },
  {
   "id": "s16",
   "group": "g15",
   "start": 41.223,
   "end": 42.909,
   "text": "Phephdon ke saath, nau hawa ki thailiyan.",
   "cap": "Phephdon ke saath, nau hawa ki thailiyan."
  },
  {
   "id": "s17",
   "group": "g16",
   "start": 43.414,
   "end": 47.58,
   "text": "Isiliye ek gidh, gyarah kilometre upar tak mila hai. Everest se bhi ooncha.",
   "cap": "Isiliye ek gidh, gyarah kilometre upar tak mila hai. Everest se bhi ooncha."
  },
  {
   "id": "s18",
   "group": "g17",
   "start": 48.231,
   "end": 49.673,
   "text": "Ab ise bada karte hain.",
   "cap": "Ab ise bada karte hain."
  },
  {
   "id": "s19",
   "group": "g18",
   "start": 50.183,
   "end": 53.199,
   "text": "Lambai dugni kijiye: pankh chaar guna, par vazan aath guna.",
   "cap": "Lambai dugni kijiye: pankh chaar guna, par vazan aath guna."
  },
  {
   "id": "s20",
   "group": "g19",
   "start": 53.701,
   "end": 56.33,
   "text": "Patang wala jaanta hai: bhaari patang ko tez hawa chahiye.",
   "cap": "Patang wala jaanta hai: bhaari patang ko tez hawa chahiye."
  },
  {
   "id": "s21",
   "group": "g20",
   "start": 56.95,
   "end": 60.634,
   "text": "Isiliye aaj ka sabse bhaari udne wala pakshi, bas unnees kilo ka hai.",
   "cap": "Isiliye aaj ka sabse bhaari udne wala pakshi, bas unnees kilo ka hai."
  },
  {
   "id": "s22",
   "group": "g21",
   "start": 61.145,
   "end": 64.99,
   "text": "Aur itihaas ka sabse bhaari, Argentavis: sattar kilo, chhe metre ke pankh.",
   "cap": "Aur itihaas ka sabse bhaari, Argentavis: sattar kilo, chhe metre ke pankh."
  },
  {
   "id": "s23",
   "group": "g22",
   "start": 65.473,
   "end": 67.851,
   "text": "Film jitna bada? Vigyan kehta hai, mushkil.",
   "cap": "Film jitna bada? Vigyan kehta hai, mushkil."
  },
  {
   "id": "s24",
   "group": "g23",
   "start": 68.368,
   "end": 70.377,
   "text": "Par kahani ka Jatayu, himmat se bada hai.",
   "cap": "Par kahani ka Jatayu, himmat se bada hai."
  },
  {
   "id": "s25",
   "group": "g24",
   "start": 71.248,
   "end": 72.433,
   "text": "Par asli dukh yeh hai.",
   "cap": "Par asli dukh yeh hai."
  },
  {
   "id": "s26",
   "group": "g25",
   "start": 72.974,
   "end": 77.613,
   "text": "Bharat ke asli Jatayu, hamare gidh, pandrah saal mein 97 pratishat khatm ho gaye.",
   "cap": "Bharat ke asli Jatayu, hamare gidh, pandrah saal mein 97 pratishat khatm ho gaye."
  },
  {
   "id": "s27",
   "group": "g26",
   "start": 78.11,
   "end": 81.017,
   "text": "Kisi Ravan ne nahi maara. Maveshiyon ki ek dard ki dawa ne.",
   "cap": "Kisi Ravan ne nahi maara. Maveshiyon ki ek dard ki dawa ne."
  },
  {
   "id": "s28",
   "group": "g27",
   "start": 81.869,
   "end": 83.922,
   "text": "2006 mein, us dawa par rok lagi.",
   "cap": "2006 mein, us dawa par rok lagi."
  },
  {
   "id": "s29",
   "group": "g28",
   "start": 84.413,
   "end": 87.338,
   "text": "Aur Haryana ke Pinjore mein, gidh paale aur chhode ja rahe hain.",
   "cap": "Aur Haryana ke Pinjore mein, gidh paale aur chhode ja rahe hain."
  },
  {
   "id": "s30",
   "group": "g29",
   "start": 87.913,
   "end": 89.632,
   "text": "Us kendra ka naam? Jatayu.",
   "cap": "Us kendra ka naam? Jatayu."
  },
  {
   "id": "s31",
   "group": "g30",
   "start": 90.541,
   "end": 92.497,
   "text": "Film ka Jatayu, Sita ke liye lada.",
   "cap": "Film ka Jatayu, Sita ke liye lada."
  },
  {
   "id": "s32",
   "group": "g31",
   "start": 92.989,
   "end": 95.027,
   "text": "Asli Jatayu, roz hamare liye ladta hai.",
   "cap": "Asli Jatayu, roz hamare liye ladta hai."
  },
  {
   "id": "s33",
   "group": "g32",
   "start": 95.555,
   "end": 97.691,
   "text": "Share aur follow karein, nerdlogic.co",
   "cap": "Share aur follow karein, nerdlogic.co"
  }
 ],
