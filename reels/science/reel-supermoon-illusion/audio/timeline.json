{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 7.751,
   "text": "24 November, Dev Deepawali ki shaam. Chaand niklega, aur sab kahenge: kitna bada! Par kya chaand sach mein bada hai, ya hamara dimaag use bada dikha raha hai?",
   "cap": "24 November, Dev Deepawali ki shaam. Chaand niklega, aur sab kahenge: kitna bada! Par kya chaand sach mein bada hai, ya hamara dimaag use bada dikha raha hai?"
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 8.47,
   "end": 16.498,
   "text": "Chaand ki parikrama thodi ande jaisi hai, isliye wo kabhi paas aata hai, kabhi door. Is poornima par wo paas hoga: lagbhag teen lakh iksath hazaar kilometer.",
   "cap": "Chaand ki parikrama thodi ande jaisi hai, isliye wo kabhi paas aata hai, kabhi door. Is poornima par wo paas hoga: lagbhag teen lakh iksath hazaar kilometer."
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 16.926,
   "end": 24.695,
   "text": "Ise supermoon kehte hain. NASA ke mutabik, saal ki sabse door wali poornima se, sabse paas wali zyada se zyada chaudah pratishat badi dikh sakti hai.",
   "cap": "Ise supermoon kehte hain. NASA ke mutabik, saal ki sabse door wali poornima se, sabse paas wali zyada se zyada chaudah pratishat badi dikh sakti hai."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 25.192,
   "end": 28.953,
   "text": "Aur ye akeli nahi: December aur January mein bhi paas wali poornima aayegi.",
   "cap": "Aur ye akeli nahi: December aur January mein bhi paas wali poornima aayegi."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 29.522,
   "end": 38.649,
   "text": "Par pedon ke upar jo chaand bahut bada dikhta hai, wo asal mein bada nahi hota. NASA ka test: ek hi camera se kshitij par aur upar photo lo, chaand ki chaudaai barabar nikalti hai.",
   "cap": "Par pedon ke upar jo chaand bahut bada dikhta hai, wo asal mein bada nahi hota. NASA ka test: ek hi camera se kshitij par aur upar photo lo, chaand ki chaudaai barabar nikalti hai."
  },
  {
   "id": "s6",
   "group": "g6",
   "start": 39.104,
   "end": 47.368,
   "text": "Ise moon illusion kehte hain. Ek mukhya vyakhya hai Ponzo illusion: dimaag chaand ki tulna pedon se karta hai. NASA kehta hai, poori wajah par bahas jaari hai.",
   "cap": "Ise moon illusion kehte hain. Ek mukhya vyakhya hai Ponzo illusion: dimaag chaand ki tulna pedon se karta hai. NASA kehta hai, poori wajah par bahas jaari hai."
  },
  {
   "id": "s7",
   "group": "g7",
   "start": 47.886,
   "end": 52.569,
   "text": "Khud aazmaao: haath seedha karo. Ungli ka naakhun chaand ko dhak lega, chahe chaand neeche ho ya upar.",
   "cap": "Khud aazmaao: haath seedha karo. Ungli ka naakhun chaand ko dhak lega, chahe chaand neeche ho ya upar."
  },
  {
   "id": "s8",
   "group": "g8",
   "start": 53.283,
   "end": 62.325,
   "text": "Dev Deepawali, Kartik Purnima: Kashi ke ghaat diyon se jagmagate hain. Maanyata hai ki Shiv ji ne Tripurasur par jeet paayi thi. Aastha apni jagah, aasmaan ka naap apni jagah.",
   "cap": "Dev Deepawali, Kartik Purnima: Kashi ke ghaat diyon se jagmagate hain. Maanyata hai ki Shiv ji ne Tripurasur par jeet paayi thi. Aastha apni jagah, aasmaan ka naap apni jagah."
  },
  {
   "id": "s9",
   "group": "g9",
   "start": 62.89,
   "end": 68.959,
   "text": "To 24 November ki shaam chaand ko ungli se naapna. Kitna bada dikha? Follow aur share kariye, nerdlogic.co ko.",
   "cap": "To 24 November ki shaam chaand ko ungli se naapna. Kitna bada dikha? Follow aur share kariye, nerdlogic.co ko."
  }
