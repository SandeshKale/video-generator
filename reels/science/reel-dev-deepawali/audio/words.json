 "provisional": [],
 "B": {
  "s1": "दिवाली मना ली?",
  "s2": "देवताओं की, अभी बाक़ी है।",
  "s3": "चौबीस नवंबर।",
  "s4": "उस रात काशी के घाट, दस लाख से ज़्यादा दीयों से जलेंगे।",
  "s5": "पर यही रात क्यों?",
  "s6": "कथा कहती है: तीन असुर भाइयों के, तीन उड़ते शहर थे।",
  "s7": "सोने का, चाँदी का, लोहे का।",
  "s8": "शर्त यह थी: हज़ार साल में एक बार, तीनों एक हो जाएँगे।",
  "s9": "और तभी, एक ही तीर से टूट सकते हैं।",
  "s10": "शिव ने इंतज़ार किया।",
  "s11": "सही पल आया।",
  "s12": "एक तीर।",
  "s13": "देवताओं ने ख़ुशी में दीये जलाए।",
  "s14": "यह है शास्त्र।",
  "s15": "पर महाभारत वाली कथा में, कोई तारीख़ नहीं लिखी।",
  "s16": "तो यह रात किसने चुनी?",
  "s17": "आसमान ने।",
  "s18": "दिवाली अमावस्या थी: चाँद ग़ायब।",
  "s19": "पंद्रह दिन में चाँद, धरती का आधा चक्कर काटकर, पूरा हो जाता है।",
  "s20": "और महीने का नाम, कार्तिक, तारों के एक गुच्छे से आया: कृत्तिका।",
  "s21": "क्योंकि इस पूर्णिमा का चाँद, उसी के पास होता है।",
  "s22": "लेकिन हर साल नहीं।",
  "s23": "पिछले साल चाँद, कृत्तिका से सोलह डिग्री दूर था।",
  "s24": "इस साल, चौबीस की शाम: दो डिग्री से भी कम।",
  "s25": "बस तीन-चार चाँद जितनी दूरी।",
  "s26": "आसमान के ऐसे हिसाब चाहिए?",
  "s27": "फ़ॉलो कर लो।",
  "s28": "तो चौबीस को, छत पर एक दीया रखना।",
  "s29": "फिर चाँद को, अँगूठे से ढकना।",
  "s30": "बगल में जो गुच्छा दिखे, वही है कार्तिक का नाम।",
  "s31": "कथा शास्त्र की।",
  "s32": "तारीख़ आसमान की।"
 }
}