{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 0.795,
   "text": "Diwali mana li?",
   "cap": "Diwali mana li?"
  },
  {
   "id": "s2",
   "group": "g1",
   "start": 0.455,
   "end": 1.895,
   "text": "Devtaon ki abhi baaki hai.",
   "cap": "Devtaon ki abhi baaki hai."
  },
  {
   "id": "s3",
   "group": "g1",
   "start": 1.815,
   "end": 2.715,
   "text": "Chaubees November.",
   "cap": "Chaubees November."
  },
  {
   "id": "s4",
   "group": "g2",
   "start": 3.297,
   "end": 6.274,
   "text": "Us raat Kashi ke ghaat, das lakh se zyada diyon se jalenge.",
   "cap": "Us raat Kashi ke ghaat, das lakh se zyada diyon se jalenge."
  },
  {
   "id": "s5",
   "group": "g2",
   "start": 5.794,
   "end": 7.294,
   "text": "Par yahi raat kyon?",
   "cap": "Par yahi raat kyon?"
  },
  {
   "id": "s6",
   "group": "g4",
   "start": 8.122,
   "end": 11.384,
   "text": "Katha kehti hai: teen asur bhaiyon ke teen udte sheher the.",
   "cap": "Katha kehti hai: teen asur bhaiyon ke teen udte sheher the."
  },
  {
   "id": "s7",
   "group": "g4",
   "start": 11.024,
   "end": 12.304,
   "text": "Sone ka, chaandi ka, lohe ka.",
   "cap": "Sone ka, chaandi ka, lohe ka."
  },
  {
   "id": "s8",
   "group": "g5",
   "start": 12.897,
   "end": 16.019,
   "text": "Sharat yeh thi: hazaar saal mein ek baar, teeno ek ho jaayenge.",
   "cap": "Sharat yeh thi: hazaar saal mein ek baar, teeno ek ho jaayenge."
  },
  {
   "id": "s9",
   "group": "g5",
   "start": 15.759,
   "end": 17.839,
   "text": "Aur tabhi, ek hi teer se toot sakte hain.",
   "cap": "Aur tabhi, ek hi teer se toot sakte hain."
  },
  {
   "id": "s10",
   "group": "g6",
   "start": 18.461,
   "end": 19.57,
   "text": "Shiv ne intezaar kiya.",
   "cap": "Shiv ne intezaar kiya."
  },
  {
   "id": "s11",
   "group": "g6",
   "start": 19.33,
   "end": 20.57,
   "text": "Sahi pal aaya.",
   "cap": "Sahi pal aaya."
  },
  {
   "id": "s12",
   "group": "g6",
   "start": 20.39,
   "end": 20.77,
   "text": "Ek teer.",
   "cap": "Ek teer."
  },
  {
   "id": "s13",
   "group": "g7",
   "start": 21.791,
   "end": 23.397,
   "text": "Devtaon ne khushi mein diye jalaye.",
   "cap": "Devtaon ne khushi mein diye jalaye."
  },
  {
   "id": "s14",
   "group": "g7",
   "start": 23.057,
   "end": 24.117,
   "text": "Yeh hai shastra.",
   "cap": "Yeh hai shastra."
  },
  {
   "id": "s15",
   "group": "g8",
   "start": 24.88,
   "end": 27.484,
   "text": "Par Mahabharat wali katha mein, koi tareekh nahi likhi.",
   "cap": "Par Mahabharat wali katha mein, koi tareekh nahi likhi."
  },
  {
   "id": "s16",
   "group": "g9",
   "start": 28.004,
   "end": 29.166,
   "text": "To yeh raat kisne chuni?",
   "cap": "To yeh raat kisne chuni?"
  },
  {
   "id": "s17",
   "group": "g9",
   "start": 28.846,
   "end": 30.086,
   "text": "Aasmaan ne.",
   "cap": "Aasmaan ne."
  },
  {
   "id": "s18",
   "group": "g10",
   "start": 30.923,
   "end": 32.86,
   "text": "Diwali amavasya thi: chand gayab.",
   "cap": "Diwali amavasya thi: chand gayab."
  },
  {
   "id": "s19",
   "group": "g10",
   "start": 32.54,
   "end": 36.4,
   "text": "Pandrah din mein chand, dharti ka aadha chakkar kaat kar, poora ho jaata hai.",
   "cap": "Pandrah din mein chand, dharti ka aadha chakkar kaat kar, poora ho jaata hai."
  },
  {
   "id": "s20",
   "group": "g11",
   "start": 36.97,
   "end": 40.273,
   "text": "Aur mahine ka naam, Kartik, taaron ke ek guchhe se aaya: Krittika.",
   "cap": "Aur mahine ka naam, Kartik, taaron ke ek guchhe se aaya: Krittika."
  },
  {
   "id": "s21",
   "group": "g12",
   "start": 40.82,
   "end": 43.25,
   "text": "Kyunki is purnima ka chand, usi ke paas hota hai.",
   "cap": "Kyunki is purnima ka chand, usi ke paas hota hai."
  },
  {
   "id": "s22",
   "group": "g13",
   "start": 43.937,
   "end": 45.464,
   "text": "Lekin har saal nahi.",
   "cap": "Lekin har saal nahi."
  },
  {
   "id": "s23",
   "group": "g13",
   "start": 45.084,
   "end": 47.664,
   "text": "Pichhle saal chand, Krittika se solah degree door tha.",
   "cap": "Pichhle saal chand, Krittika se solah degree door tha."
  },
  {
   "id": "s24",
   "group": "g14",
   "start": 48.226,
   "end": 50.671,
   "text": "Is saal, chaubees ki shaam: do degree se bhi kam.",
   "cap": "Is saal, chaubees ki shaam: do degree se bhi kam."
  },
  {
   "id": "s25",
   "group": "g14",
   "start": 50.351,
   "end": 52.031,
   "text": "Bas teen-chaar chand jitni doori.",
   "cap": "Bas teen-chaar chand jitni doori."
  },
  {
   "id": "s26",
   "group": "g15",
   "start": 52.99,
   "end": 54.431,
   "text": "Aasmaan ke aise hisaab chahiye?",
   "cap": "Aasmaan ke aise hisaab chahiye?"
  },
  {
   "id": "s27",
   "group": "g15",
   "start": 54.091,
   "end": 55.251,
   "text": "Follow kar lo.",
   "cap": "Follow kar lo."
  },
  {
   "id": "s28",
   "group": "g16",
   "start": 55.83,
   "end": 57.973,
   "text": "To chaubees ko, chhat par ek diya rakhna.",
   "cap": "To chaubees ko, chhat par ek diya rakhna."
  },
  {
   "id": "s29",
   "group": "g16",
   "start": 57.813,
   "end": 59.333,
   "text": "Phir chand ko, angoothe se dhakna.",
   "cap": "Phir chand ko, angoothe se dhakna."
  },
  {
   "id": "s30",
   "group": "g17",
   "start": 59.966,
   "end": 62.267,
   "text": "Bagal mein jo guchha dikhe, wahi hai Kartik ka naam.",
   "cap": "Bagal mein jo guchha dikhe, wahi hai Kartik ka naam."
  },
  {
   "id": "s31",
   "group": "g18",
   "start": 63.079,
   "end": 64.039,
   "text": "Katha shastra ki.",
   "cap": "Katha shastra ki."
  },
  {
   "id": "s32",
   "group": "g18",
   "start": 63.879,
   "end": 65.059,
   "text": "Tareekh aasmaan ki.",
   "cap": "Tareekh aasmaan ki."
  }
 ],
