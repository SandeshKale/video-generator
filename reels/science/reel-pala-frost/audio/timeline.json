{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 1.956,
   "text": "Raat ko thermometer mein chaar degree.",
   "cap": "Raat ko thermometer mein chaar degree."
  },
  {
   "id": "s2",
   "group": "g1",
   "start": 1.536,
   "end": 3.256,
   "text": "Phir bhi subah khet par pala.",
   "cap": "Phir bhi subah khet par pala."
  },
  {
   "id": "s3",
   "group": "g2",
   "start": 3.784,
   "end": 4.707,
   "text": "Aisa kaise?",
   "cap": "Aisa kaise?"
  },
  {
   "id": "s4",
   "group": "g3",
   "start": 5.642,
   "end": 7.768,
   "text": "Pala padte hi aloo aur sarson jal jaate hain.",
   "cap": "Pala padte hi aloo aur sarson jal jaate hain."
  },
  {
   "id": "s5",
   "group": "g3b",
   "start": 8.227,
   "end": 14.37,
   "text": "Bihar mein 2024 ki sardi-kohre mein, der se boye aloo mein pachchis se chalis pratishat nuksaan bataya gaya.",
   "cap": "Bihar mein 2024 ki sardi-kohre mein, der se boye aloo mein pachchis se chalis pratishat nuksaan bataya gaya."
  },
  {
   "id": "s6",
   "group": "g4",
   "start": 14.952,
   "end": 17.132,
   "text": "Ant mein ek test: aaj raat khud kar lena.",
   "cap": "Ant mein ek test: aaj raat khud kar lena."
  },
  {
   "id": "s7",
   "group": "g5",
   "start": 17.769,
   "end": 21.412,
   "text": "Thermometer hawa ka tapman batata hai, lagbhag chaati ki unchai par.",
   "cap": "Thermometer hawa ka tapman batata hai, lagbhag chaati ki unchai par."
  },
  {
   "id": "s8",
   "group": "g5",
   "start": 21.052,
   "end": 23.892,
   "text": "Par patta zameen ke paas hai, khule aasmaan ke neeche.",
   "cap": "Par patta zameen ke paas hai, khule aasmaan ke neeche."
  },
  {
   "id": "s9",
   "group": "g6",
   "start": 24.658,
   "end": 26.219,
   "text": "Ise kehte hain zameeni pala.",
   "cap": "Ise kehte hain zameeni pala."
  },
  {
   "id": "s10",
   "group": "g7",
   "start": 27.065,
   "end": 29.107,
   "text": "Din mein patta dhoop se garmi leta hai.",
   "cap": "Din mein patta dhoop se garmi leta hai."
  },
  {
   "id": "s11",
   "group": "g7",
   "start": 28.787,
   "end": 31.567,
   "text": "Raat ko wahi garmi aasmaan ki taraf chhod deta hai.",
   "cap": "Raat ko wahi garmi aasmaan ki taraf chhod deta hai."
  },
  {
   "id": "s12",
   "group": "g8",
   "start": 32.099,
   "end": 33.594,
   "text": "Baadal ho, to garmi lautti hai.",
   "cap": "Baadal ho, to garmi lautti hai."
  },
  {
   "id": "s13",
   "group": "g8",
   "start": 33.514,
   "end": 34.654,
   "text": "Saaf aasmaan mein nahi.",
   "cap": "Saaf aasmaan mein nahi."
  },
  {
   "id": "s14",
   "group": "g9",
   "start": 35.433,
   "end": 38.174,
   "text": "Saaf aasmaan aur halki hawa: sabse khatarnak raat.",
   "cap": "Saaf aasmaan aur halki hawa: sabse khatarnak raat."
  },
  {
   "id": "s15",
   "group": "g10",
   "start": 39.052,
   "end": 43.436,
   "text": "Thandi hawa bhaari hoti hai, dhalaan se bahkar neeche ke khet mein bhar jaati hai, jaise baadh ka paani.",
   "cap": "Thandi hawa bhaari hoti hai, dhalaan se bahkar neeche ke khet mein bhar jaati hai, jaise baadh ka paani."
  },
  {
   "id": "s16",
   "group": "g11",
   "start": 44.291,
   "end": 45.279,
   "text": "Kya kaam karta hai?",
   "cap": "Kya kaam karta hai?"
  },
  {
   "id": "s17",
   "group": "g11",
   "start": 45.019,
   "end": 47.499,
   "text": "Shaam ko sinchai: geeli mitti garmi rokti hai.",
   "cap": "Shaam ko sinchai: geeli mitti garmi rokti hai."
  },
  {
   "id": "s18",
   "group": "g12",
   "start": 47.954,
   "end": 50.294,
   "text": "Aur nursery ko tat, bhoose ya polythene se dhako.",
   "cap": "Aur nursery ko tat, bhoose ya polythene se dhako."
  },
  {
   "id": "s19",
   "group": "g13",
   "start": 51.042,
   "end": 53.051,
   "text": "Kai rajya dhuan karne ko kehte hain.",
   "cap": "Kai rajya dhuan karne ko kehte hain."
  },
  {
   "id": "s20",
   "group": "g13",
   "start": 52.671,
   "end": 55.451,
   "text": "Par FAO ki research mein dhuan se fayda nahi mila.",
   "cap": "Par FAO ki research mein dhuan se fayda nahi mila."
  },
  {
   "id": "s21",
   "group": "g14",
   "start": 56.358,
   "end": 59.884,
   "text": "Aisi kheti-mausam ki baatein chahiye? nerdlogic dot co ko follow karo.",
   "cap": "Aisi kheti-mausam ki baatein chahiye? nerdlogic dot co ko follow karo."
  },
  {
   "id": "s22",
   "group": "g15",
   "start": 60.467,
   "end": 64.937,
   "text": "Aaj raat aasmaan saaf ho, to ek thermometer zameen par rakho, ek chaati ki unchai par.",
   "cap": "Aaj raat aasmaan saaf ho, to ek thermometer zameen par rakho, ek chaati ki unchai par."
  },
  {
   "id": "s23",
   "group": "g15",
   "start": 64.717,
   "end": 65.837,
   "text": "Subah dono dekho.",
   "cap": "Subah dono dekho."
  },
  {
   "id": "s24",
   "group": "g15",
   "start": 65.477,
   "end": 67.757,
   "text": "Badal wali raat mein farq kam hoga.",
   "cap": "Badal wali raat mein farq kam hoga."
  },
  {
   "id": "s25",
   "group": "g16",
   "start": 68.484,
   "end": 70.931,
   "text": "Kal ka mausam: Meghdoot app ya Kisan Call Centre.",
   "cap": "Kal ka mausam: Meghdoot app ya Kisan Call Centre."
  },
  {
   "id": "s26",
   "group": "g17",
   "start": 71.705,
   "end": 73.948,
   "text": "Pala hawa se nahi, saaf aasmaan se padta hai.",
   "cap": "Pala hawa se nahi, saaf aasmaan se padta hai."
  }
