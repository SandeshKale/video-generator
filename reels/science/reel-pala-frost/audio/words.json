 "provisional": [],
 "B": {
  "s1": "रात को थर्मामीटर में चार डिग्री।",
  "s2": "फिर भी सुबह खेत पर पाला।",
  "s3": "ऐसा कैसे?",
  "s4": "पाला पड़ते ही आलू और सरसों जल जाते हैं।",
  "s5": "बिहार में दो हज़ार चौबीस की सर्दी-कोहरे में, देर से बोए आलू में पच्चीस से चालीस प्रतिशत नुकसान बताया गया।",
  "s6": "अंत में एक टेस्ट: आज रात खुद कर लेना।",
  "s7": "थर्मामीटर हवा का तापमान बताता है, लगभग छाती की ऊँचाई पर।",
  "s8": "पर पत्ता ज़मीन के पास है, खुले आसमान के नीचे।",
  "s9": "इसे कहते हैं ज़मीनी पाला।",
  "s10": "दिन में पत्ता धूप से गर्मी लेता है।",
  "s11": "रात को वही गर्मी आसमान की तरफ़ छोड़ देता है।",
  "s12": "बादल हो, तो गर्मी लौटती है।",
  "s13": "साफ़ आसमान में नहीं।",
  "s14": "साफ़ आसमान और हल्की हवा: सबसे ख़तरनाक रात।",
  "s15": "ठंडी हवा भारी होती है, ढलान से बहकर नीचे के खेत में भर जाती है, जैसे बाढ़ का पानी।",
  "s16": "क्या काम करता है?",
  "s17": "शाम को सिंचाई: गीली मिट्टी गर्मी रोकती है।",
  "s18": "और नर्सरी को टाट, भूसे या पॉलीथीन से ढको।",
  "s19": "कई राज्य धुआँ करने को कहते हैं।",
  "s20": "पर एफ़ ए ओ की रिसर्च में धुएँ से फ़ायदा नहीं मिला।",
  "s21": "ऐसी खेती-मौसम की बातें चाहिए? नर्डलॉजिक डॉट सी ओ को फ़ॉलो करो।",
  "s22": "आज रात आसमान साफ़ हो, तो एक थर्मामीटर ज़मीन पर रखो, एक छाती की ऊँचाई पर।",
  "s23": "सुबह दोनों देखो।",
  "s24": "बादल वाली रात में फ़र्क़ कम होगा।",
  "s25": "कल का मौसम: मेघदूत ऐप या किसान कॉल सेंटर।",
  "s26": "पाला हवा से नहीं, साफ़ आसमान से पड़ता है।"
 }
}