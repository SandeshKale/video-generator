{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 4.216,
   "text": "Ramayana film ke makers ne, Pushpak Viman ke 40-50 design banaye.",
   "cap": "Ramayana film ke makers ne, Pushpak Viman ke 40-50 design banaye."
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 4.993,
   "end": 6.765,
   "text": "Sirf design mein, 2 saal lage.",
   "cap": "Sirf design mein, 2 saal lage."
  },
  {
   "id": "s3",
   "group": "g2",
   "start": 6.225,
   "end": 10.377,
   "text": "Aur Ravan-Jatayu ki ladaai? 6.5 saal!",
   "cap": "Aur Ravan-Jatayu ki ladaai? 6.5 saal!"
  },
  {
   "id": "s4",
   "group": "g3",
   "start": 11.013,
   "end": 14.993,
   "text": "Director Nitesh Tiwari ne kaha: hum chahte the, isme thoda science ho.",
   "cap": "Director Nitesh Tiwari ne kaha: hum chahte the, isme thoda science ho."
  },
  {
   "id": "s5",
   "group": "g4",
   "start": 15.666,
   "end": 18.67,
   "text": "Toh chaliye, wahi karte hain. Par film ki copy nahi.",
   "cap": "Toh chaliye, wahi karte hain. Par film ki copy nahi."
  },
  {
   "id": "s6",
   "group": "g5",
   "start": 19.226,
   "end": 22.613,
   "text": "Valmiki ki apni lines se, ise hissa-hissa kholkar dekhte hain.",
   "cap": "Valmiki ki apni lines se, ise hissa-hissa kholkar dekhte hain."
  },
  {
   "id": "s7",
   "group": "g6",
   "start": 23.18,
   "end": 25.685,
   "text": "Aakaar: pahaad jaisa, kai shikharon waala.",
   "cap": "Aakaar: pahaad jaisa, kai shikharon waala."
  },
  {
   "id": "s8",
   "group": "g6",
   "start": 25.505,
   "end": 26.805,
   "text": "Dhaancha: sona aur heere.",
   "cap": "Dhaancha: sona aur heere."
  },
  {
   "id": "s9",
   "group": "g7",
   "start": 27.418,
   "end": 29.386,
   "text": "Khambhon par, bhediyon ki nakkaashi.",
   "cap": "Khambhon par, bhediyon ki nakkaashi."
  },
  {
   "id": "s10",
   "group": "g7",
   "start": 29.106,
   "end": 29.666,
   "text": "Seedhiyaan, sone ki.",
   "cap": "Seedhiyaan, sone ki."
  },
  {
   "id": "s11",
   "group": "g8",
   "start": 30.297,
   "end": 31.765,
   "text": "Farsh, moonge aur ratnon ka.",
   "cap": "Farsh, moonge aur ratnon ka."
  },
  {
   "id": "s12",
   "group": "g8",
   "start": 31.565,
   "end": 34.165,
   "text": "Aur khidkiyaan crystal ki, saath mein hawa ke chhed bhi!",
   "cap": "Aur khidkiyaan crystal ki, saath mein hawa ke chhed bhi!"
  },
  {
   "id": "s13",
   "group": "g9",
   "start": 34.821,
   "end": 37.062,
   "text": "Valmiki ne, iske ventilation tak likhe hain.",
   "cap": "Valmiki ne, iske ventilation tak likhe hain."
  },
  {
   "id": "s14",
   "group": "g10",
   "start": 37.625,
   "end": 39.777,
   "text": "Par ek cheez gaayab hai. Engine.",
   "cap": "Par ek cheez gaayab hai. Engine."
  },
  {
   "id": "s15",
   "group": "g11",
   "start": 40.431,
   "end": 43.851,
   "text": "Valmiki kehte hain, ye mann ke vichaar se chalta hai, soch jitna tez.",
   "cap": "Valmiki kehte hain, ye mann ke vichaar se chalta hai, soch jitna tez."
  },
  {
   "id": "s16",
   "group": "g12",
   "start": 44.426,
   "end": 48.046,
   "text": "Aur ek jagah likha hai, ise aasmaan mein rakshas aur bhootgan uthaate hain.",
   "cap": "Aur ek jagah likha hai, ise aasmaan mein rakshas aur bhootgan uthaate hain."
  },
  {
   "id": "s17",
   "group": "g13",
   "start": 48.571,
   "end": 49.919,
   "text": "Film ne iska jawaab diya.",
   "cap": "Film ne iska jawaab diya."
  },
  {
   "id": "s18",
   "group": "g13b",
   "start": 50.376,
   "end": 54.248,
   "text": "Reviews ke mutaabik, Pushpak ka gumbad, ek hot-air balloon jaisa hai.",
   "cap": "Reviews ke mutaabik, Pushpak ka gumbad, ek hot-air balloon jaisa hai."
  },
  {
   "id": "s19",
   "group": "g14",
   "start": 54.786,
   "end": 56.306,
   "text": "Aur ye science se sahi hai!",
   "cap": "Aur ye science se sahi hai!"
  },
  {
   "id": "s20",
   "group": "g14b",
   "start": 56.814,
   "end": 59.815,
   "text": "Garam hawa, thandi hawa se halki hoti hai, isliye upar uthti hai.",
   "cap": "Garam hawa, thandi hawa se halki hoti hai, isliye upar uthti hai."
  },
  {
   "id": "s21",
   "group": "g15",
   "start": 60.498,
   "end": 64.598,
   "text": "Bas ek dikkat: sirf 1 ghan meter sona, 19 ton ka hota hai.",
   "cap": "Bas ek dikkat: sirf 1 ghan meter sona, 19 ton ka hota hai."
  },
  {
   "id": "s22",
   "group": "g15b",
   "start": 65.15,
   "end": 69.156,
   "text": "Use uthaane ke liye, lagbhag 25 passenger balloon jitni garam hawa chahiye.",
   "cap": "Use uthaane ke liye, lagbhag 25 passenger balloon jitni garam hawa chahiye."
  },
  {
   "id": "s23",
   "group": "g16",
   "start": 69.769,
   "end": 73.716,
   "text": "Phir wo prachin vimaan shastra ka kya, jiski photo aap forward karte hain?",
   "cap": "Phir wo prachin vimaan shastra ka kya, jiski photo aap forward karte hain?"
  },
  {
   "id": "s24",
   "group": "g17",
   "start": 74.183,
   "end": 77.528,
   "text": "Wo kitaab, 1918 se 1923 ke beech likhwaai gayi.",
   "cap": "Wo kitaab, 1918 se 1923 ke beech likhwaai gayi."
  },
  {
   "id": "s25",
   "group": "g18",
   "start": 78.078,
   "end": 82.014,
   "text": "Aur 1974 mein, IISc ke 5 vaigyanikon ne use jaancha.",
   "cap": "Aur 1974 mein, IISc ke 5 vaigyanikon ne use jaancha."
  },
  {
   "id": "s26",
   "group": "g18b",
   "start": 82.588,
   "end": 85.656,
   "text": "Faisla: inme se koi bhi plane, ud nahi sakta.",
   "cap": "Faisla: inme se koi bhi plane, ud nahi sakta."
  },
  {
   "id": "s27",
   "group": "g19",
   "start": 86.351,
   "end": 90.143,
   "text": "Ek aur farak. Film mein Ravan, Sita ji ko Pushpak mein le jaata hai.",
   "cap": "Ek aur farak. Film mein Ravan, Sita ji ko Pushpak mein le jaata hai."
  },
  {
   "id": "s28",
   "group": "g19b",
   "start": 90.674,
   "end": 92.293,
   "text": "Aur Jatayu, usi par ladte hain.",
   "cap": "Aur Jatayu, usi par ladte hain."
  },
  {
   "id": "s29",
   "group": "g20",
   "start": 92.738,
   "end": 96.299,
   "text": "Valmiki mein wo ek rath hai, gadhon se khincha hua, jise Jatayu tod dete hain.",
   "cap": "Valmiki mein wo ek rath hai, gadhon se khincha hua, jise Jatayu tod dete hain."
  },
  {
   "id": "s30",
   "group": "g21",
   "start": 96.893,
   "end": 98.798,
   "text": "Par Pushpak ki asli science yahaan hai.",
   "cap": "Par Pushpak ki asli science yahaan hai."
  },
  {
   "id": "s31",
   "group": "g21b",
   "start": 99.208,
   "end": 102.267,
   "text": "Lautte waqt, Ram ne Sita ji ko, upar se poora raasta dikhaya.",
   "cap": "Lautte waqt, Ram ne Sita ji ko, upar se poora raasta dikhaya."
  },
  {
   "id": "s32",
   "group": "g22",
   "start": 102.865,
   "end": 106.297,
   "text": "Lanka, Setu, Kishkindha, Panchavati, Chitrakoot, Prayag, Ayodhya.",
   "cap": "Lanka, Setu, Kishkindha, Panchavati, Chitrakoot, Prayag, Ayodhya."
  },
  {
   "id": "s33",
   "group": "g22b",
   "start": 106.926,
   "end": 108.808,
   "text": "Lagbhag 2,700 kilometre.",
   "cap": "Lagbhag 2,700 kilometre."
  },
  {
   "id": "s34",
   "group": "g23",
   "start": 109.443,
   "end": 113.832,
   "text": "Aur aaj? ISRO ka ek spaceplane, jo khud runway par utarta hai.",
   "cap": "Aur aaj? ISRO ka ek spaceplane, jo khud runway par utarta hai."
  },
  {
   "id": "s35",
   "group": "g23b",
   "start": 114.355,
   "end": 115.718,
   "text": "Uska naam hai, Pushpak.",
   "cap": "Uska naam hai, Pushpak."
  },
  {
   "id": "s36",
   "group": "g24",
   "start": 116.254,
   "end": 119.308,
   "text": "Film ka Part 2, 2028 ki Diwali par aayega.",
   "cap": "Film ka Part 2, 2028 ki Diwali par aayega."
  },
  {
   "id": "s37",
   "group": "g25",
   "start": 119.912,
   "end": 124.795,
   "text": "Aisi aur kahaniyon ke liye, like, share aur subscribe karein, nerdlogic.co ko!",
   "cap": "Aisi aur kahaniyon ke liye, like, share aur subscribe karein, nerdlogic.co ko!"
  }
 ],
