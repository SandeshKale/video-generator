{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 1.779,
   "text": "Film mein Ravan ki Lanka, sone ki hai.",
   "cap": "Film mein Ravan ki Lanka, sone ki hai."
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 2.284,
   "end": 4.089,
   "text": "Par duniya mein, itna sona hai bhi?",
   "cap": "Par duniya mein, itna sona hai bhi?"
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 5.067,
   "end": 6.696,
   "text": "Chaliye, eent se naapte hain.",
   "cap": "Chaliye, eent se naapte hain."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 7.256,
   "end": 9.116,
   "text": "Aapke ghar ki ek eent: teen kilo.",
   "cap": "Aapke ghar ki ek eent: teen kilo."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 9.728,
   "end": 11.61,
   "text": "Wahi eent sone ki ho, to saintees kilo!",
   "cap": "Wahi eent sone ki ho, to saintees kilo!"
  },
  {
   "id": "s6",
   "group": "g6",
   "start": 12.397,
   "end": 14.359,
   "text": "Ab duniya ka saara sona ikattha kijiye.",
   "cap": "Ab duniya ka saara sona ikattha kijiye."
  },
  {
   "id": "s7",
   "group": "g7",
   "start": 14.986,
   "end": 16.925,
   "text": "Jitna aaj tak, zameen se nikla hai.",
   "cap": "Jitna aaj tak, zameen se nikla hai."
  },
  {
   "id": "s8",
   "group": "g8",
   "start": 17.413,
   "end": 19.407,
   "text": "Sirf ek dibba banega: baees metre ka.",
   "cap": "Sirf ek dibba banega: baees metre ka."
  },
  {
   "id": "s9",
   "group": "g9",
   "start": 20.013,
   "end": 21.317,
   "text": "Ek cricket pitch jitna.",
   "cap": "Ek cricket pitch jitna."
  },
  {
   "id": "s10",
   "group": "g10",
   "start": 22.192,
   "end": 24.077,
   "text": "Ab ise khol ke, eentein banate hain.",
   "cap": "Ab ise khol ke, eentein banate hain."
  },
  {
   "id": "s11",
   "group": "g11",
   "start": 24.553,
   "end": 26.057,
   "text": "Lagbhag saath lakh eentein.",
   "cap": "Lagbhag saath lakh eentein."
  },
  {
   "id": "s12",
   "group": "g12",
   "start": 26.554,
   "end": 28.759,
   "text": "Ek pakke ghar mein, das hazaar eent lagti hain.",
   "cap": "Ek pakke ghar mein, das hazaar eent lagti hain."
  },
  {
   "id": "s13",
   "group": "g13",
   "start": 29.288,
   "end": 31.277,
   "text": "To kul kitne ghar bane? Sirf chhe sau.",
   "cap": "To kul kitne ghar bane? Sirf chhe sau."
  },
  {
   "id": "s14",
   "group": "g14",
   "start": 31.77,
   "end": 33.794,
   "text": "Poori duniya ka sona: ek gaon. Lanka nahi.",
   "cap": "Poori duniya ka sona: ek gaon. Lanka nahi."
  },
  {
   "id": "s15",
   "group": "g15",
   "start": 34.782,
   "end": 36.254,
   "text": "To kya sone ki Lanka jhooth hai?",
   "cap": "To kya sone ki Lanka jhooth hai?"
  },
  {
   "id": "s16",
   "group": "g16",
   "start": 37.229,
   "end": 39.036,
   "text": "Nahi. Valmiki ne likha hai:",
   "cap": "Nahi. Valmiki ne likha hai:"
  },
  {
   "id": "s17",
   "group": "g17",
   "start": 39.4,
   "end": 42.158,
   "text": "Safed mahal, aur sone ke darwaze, khidkiyan, aur deewar.",
   "cap": "Safed mahal, aur sone ke darwaze, khidkiyan, aur deewar."
  },
  {
   "id": "s18",
   "group": "g18",
   "start": 42.718,
   "end": 44.919,
   "text": "Yaani pathar ke upar, sone ki patli parat.",
   "cap": "Yaani pathar ke upar, sone ki patli parat."
  },
  {
   "id": "s19",
   "group": "g19",
   "start": 45.406,
   "end": 47.143,
   "text": "Jaise mithai par, chaandi ka vark.",
   "cap": "Jaise mithai par, chaandi ka vark."
  },
  {
   "id": "s20",
   "group": "g20",
   "start": 47.649,
   "end": 49.909,
   "text": "Ek gram sona, ek chhoti khidki dhak deta hai.",
   "cap": "Ek gram sona, ek chhoti khidki dhak deta hai."
  },
  {
   "id": "s21",
   "group": "g21",
   "start": 50.439,
   "end": 51.886,
   "text": "Film walon ne bhi yahi kiya.",
   "cap": "Film walon ne bhi yahi kiya."
  },
  {
   "id": "s22",
   "group": "g22",
   "start": 52.414,
   "end": 55.556,
   "text": "Ravan ka sinhasan fibre ka hai, upar asli sone ka vark.",
   "cap": "Ravan ka sinhasan fibre ka hai, upar asli sone ka vark."
  },
  {
   "id": "s23",
   "group": "g23",
   "start": 56.145,
   "end": 58.169,
   "text": "Aisi aur kahaniyon ke liye, follow kijiye.",
   "cap": "Aisi aur kahaniyon ke liye, follow kijiye."
  },
  {
   "id": "s24",
   "group": "g24",
   "start": 58.659,
   "end": 59.989,
   "text": "Aur asli sone ki Lanka?",
   "cap": "Aur asli sone ki Lanka?"
  },
  {
   "id": "s25",
   "group": "g25",
   "start": 60.768,
   "end": 63.345,
   "text": "Bharat ke gharon mein, pachchees hazaar ton sona rakha hai.",
   "cap": "Bharat ke gharon mein, pachchees hazaar ton sona rakha hai."
  },
  {
   "id": "s26",
   "group": "g26",
   "start": 63.88,
   "end": 66.432,
   "text": "Duniya ki har nau mein se ek eent, hamari almaari mein.",
   "cap": "Duniya ki har nau mein se ek eent, hamari almaari mein."
  },
  {
   "id": "s27",
   "group": "g27",
   "start": 66.999,
   "end": 68.888,
   "text": "Share kijiye. nerdlogic.co",
   "cap": "Share kijiye. nerdlogic.co"
  }
 ],
