 "provisional": [],
 "B": {
  "s1": "फ़िल्म में रावण की लंका, सोने की है।",
  "s2": "पर दुनिया में, इतना सोना है भी?",
  "s3": "चलिए, ईंट से नापते हैं।",
  "s4": "आपके घर की एक ईंट: तीन किलो।",
  "s5": "वही ईंट सोने की हो, तो सैंतीस किलो!",
  "s6": "अब दुनिया का सारा सोना इकट्ठा कीजिए।",
  "s7": "जितना आज तक, ज़मीन से निकला है।",
  "s8": "सिर्फ़ एक डिब्बा बनेगा: बाईस मीटर का।",
  "s9": "एक क्रिकेट पिच जितना।",
  "s10": "अब इसे खोल के, ईंटें बनाते हैं।",
  "s11": "लगभग साठ लाख ईंटें।",
  "s12": "एक पक्के घर में, दस हज़ार ईंट लगती हैं।",
  "s13": "तो कुल कितने घर बने? सिर्फ़ छह सौ।",
  "s14": "पूरी दुनिया का सोना: एक गाँव। लंका नहीं।",
  "s15": "तो क्या सोने की लंका झूठ है?",
  "s16": "नहीं। वाल्मीकि ने लिखा है:",
  "s17": "सफ़ेद महल, और सोने के दरवाज़े, खिड़कियाँ, और दीवार।",
  "s18": "यानी पत्थर के ऊपर, सोने की पतली परत।",
  "s19": "जैसे मिठाई पर, चाँदी का वर्क।",
  "s20": "एक ग्राम सोना, एक छोटी खिड़की ढक देता है।",
  "s21": "फ़िल्म वालों ने भी यही किया।",
  "s22": "रावण का सिंहासन फ़ाइबर का है, ऊपर असली सोने का वर्क।",
  "s23": "ऐसी और कहानियों के लिए, फ़ॉलो कीजिए।",
  "s24": "और असली सोने की लंका?",
  "s25": "भारत के घरों में, पच्चीस हज़ार टन सोना रखा है।",
  "s26": "दुनिया की हर नौ में से एक ईंट, हमारी अलमारी में।",
  "s27": "शेयर कीजिए। नर्डलॉजिक डॉट सी ओ।"
 }
}