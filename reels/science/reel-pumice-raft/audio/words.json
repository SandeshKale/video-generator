 "provisional": [],
 "B": {
  "s1": "ये पत्थर पानी में डालो। डूबा? नहीं। तैर गया!",
  "s2": "इसे प्यूमिस कहते हैं। ये ज्वालामुखी के झाग से बना पत्थर है, और इसके अंदर हज़ारों छोटे हवा के बुलबुले बंद हैं।",
  "s3": "बुलबुले इसे पानी से हल्का रखते हैं, इसीलिए ये तैरता है। जब तक पानी अंदर नहीं भर जाता, ये डूबता नहीं।",
  "s4": "अब सोचो, एक ज्वालामुखी से ऐसे बेशुमार टुकड़े। इसी साल मई में, पापुआ न्यू गिनी के पास, समुद्र के नीचे एक ज्वालामुखी फटा।",
  "s5": "चार जून को NASA के सैटेलाइट ने उसे देखा: पानी का रंग बदला हुआ, और पास में तैरता प्यूमिस।",
  "s6": "जून की शुरुआत में प्यूमिस की परतें बहकर एडमिरल्टी द्वीपों तक पहुँचीं। कुछ किनारों पर कई मीटर मोटी परत जमी, ऐसा स्थानीय मीडिया ने बताया।",
  "s7": "NASA के मुताबिक ऐसे राफ़्ट महीनों से सालों तक तैर सकते हैं। दो हज़ार बारह में, एक राफ़्ट शुरू में लगभग चार सौ वर्ग किलोमीटर का था।",
  "s8": "रामायण में तैरते पत्थरों से राम सेतु बनने की कहानी है। वो आस्था और कहानी है। विज्ञान बस इतना कहता है कि तैरने वाले पत्थर असली होते हैं।",
  "s9": "आपके घर में भी शायद असली प्यूमिस हो: पैर घिसने वाला पत्थर। पानी में डालकर देखो।",
  "s10": "फ़ॉलो और शेयर करो, नर्डलॉजिक डॉट सी ओ।"
 }
}