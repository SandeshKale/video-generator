{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 2.243,
   "text": "Ye patthar paani mein daalo. Dooba? Nahi. Tair gaya!",
   "cap": "Ye patthar paani mein daalo. Dooba? Nahi. Tair gaya!"
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 2.821,
   "end": 9.043,
   "text": "Ise pumice kehte hain. Ye jwalamukhi ke jhaag se bana patthar hai, aur iske andar hazaaron chhote hawa ke bulbule band hain.",
   "cap": "Ise pumice kehte hain. Ye jwalamukhi ke jhaag se bana patthar hai, aur iske andar hazaaron chhote hawa ke bulbule band hain."
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 9.635,
   "end": 15.274,
   "text": "Bulbule ise paani se halka rakhte hain, isiliye ye tairta hai. Jab tak paani andar nahi bhar jaata, ye doobta nahi.",
   "cap": "Bulbule ise paani se halka rakhte hain, isiliye ye tairta hai. Jab tak paani andar nahi bhar jaata, ye doobta nahi."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 15.847,
   "end": 23.005,
   "text": "Ab socho, ek jwalamukhi se aise beshumaar tukde. Mai 2026 mein, Papua New Guinea ke paas, samundar ke neeche ek jwalamukhi phata.",
   "cap": "Ab socho, ek jwalamukhi se aise beshumaar tukde. Mai 2026 mein, Papua New Guinea ke paas, samundar ke neeche ek jwalamukhi phata."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 23.62,
   "end": 28.662,
   "text": "Chaar June ko NASA ke satellite ne use dekha: paani ka rang badla hua, aur paas mein tairta pumice.",
   "cap": "Chaar June ko NASA ke satellite ne use dekha: paani ka rang badla hua, aur paas mein tairta pumice."
  },
  {
   "id": "s6",
   "group": "g6",
   "start": 29.189,
   "end": 37.109,
   "text": "June ki shuruaat mein pumice ki parten bahkar Admiralty dweepon tak pahunchi. Kuch kinaron par kai meter moti parat jami, aisa sthaaniya media ne bataya.",
   "cap": "June ki shuruaat mein pumice ki parten bahkar Admiralty dweepon tak pahunchi. Kuch kinaron par kai meter moti parat jami, aisa sthaaniya media ne bataya."
  },
  {
   "id": "s7",
   "group": "g7",
   "start": 37.628,
   "end": 44.769,
   "text": "NASA ke mutabik aise raft mahino se saalon tak tair sakte hain. 2012 mein, ek raft shuru mein lagbhag chaar sau vargkilometre ka tha.",
   "cap": "NASA ke mutabik aise raft mahino se saalon tak tair sakte hain. 2012 mein, ek raft shuru mein lagbhag chaar sau vargkilometre ka tha."
  },
  {
   "id": "s8",
   "group": "g8",
   "start": 45.43,
   "end": 53.413,
   "text": "Ramayana mein tairte pattharon se Ram Setu banne ki kahani hai. Wo aastha aur kahani hai. Vigyan bas itna kehta hai ki tairne wale patthar asli hote hain.",
   "cap": "Ramayana mein tairte pattharon se Ram Setu banne ki kahani hai. Wo aastha aur kahani hai. Vigyan bas itna kehta hai ki tairne wale patthar asli hote hain."
  },
  {
   "id": "s9",
   "group": "g9",
   "start": 53.946,
   "end": 58.407,
   "text": "Aapke ghar mein bhi shayad asli pumice ho: pair ghisne wala patthar. Paani mein daalkar dekho.",
   "cap": "Aapke ghar mein bhi shayad asli pumice ho: pair ghisne wala patthar. Paani mein daalkar dekho."
  },
  {
   "id": "s10",
   "group": "g10",
   "start": 58.988,
   "end": 61.044,
   "text": "Follow aur share karo, nerdlogic dot co.",
   "cap": "Follow aur share karo, nerdlogic.co."
  }
 ],
