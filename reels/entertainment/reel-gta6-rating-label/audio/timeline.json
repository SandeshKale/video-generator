{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 2.596,
   "text": "GTA 6 mein steamy scenes hain. Yeh afwah nahi hai.",
   "cap": "GTA 6 mein steamy scenes hain. Yeh afwah nahi hai."
  },
  {
   "id": "s2",
   "group": "g1",
   "start": 2.376,
   "end": 4.056,
   "text": "Rating board ne khud likha hai.",
   "cap": "Rating board ne khud likha hai."
  },
  {
   "id": "s3",
   "group": "g2",
   "start": 4.705,
   "end": 8.627,
   "text": "Pehle America. ESRB ka label: M, yaani Mature, satrah plus.",
   "cap": "Pehle America. ESRB ka label: M, yaani Mature, satrah plus."
  },
  {
   "id": "s4",
   "group": "g3",
   "start": 9.294,
   "end": 15.396,
   "text": "Label mein saat cheezein likhi hain. Maardhaad, tez hinsa, gaali, nudity, mature humor, nasha, aur strong sexual content.",
   "cap": "Label mein saat cheezein likhi hain. Maardhaad, tez hinsa, gaali, nudity, mature humor, nasha, aur strong sexual content."
  },
  {
   "id": "s5",
   "group": "g4",
   "start": 15.925,
   "end": 20.23,
   "text": "Sunkar lagta hai ki yeh naya hai. Par GTA 5 ke label par bhi yahi saat cheezein hain.",
   "cap": "Sunkar lagta hai ki yeh naya hai. Par GTA 5 ke label par bhi yahi saat cheezein hain."
  },
  {
   "id": "s6",
   "group": "g5",
   "start": 20.777,
   "end": 22.364,
   "text": "Toh naya kya hai? Shabd.",
   "cap": "Toh naya kya hai? Shabd."
  },
  {
   "id": "s7",
   "group": "g6",
   "start": 22.662,
   "end": 26.466,
   "text": "Australia aur New Zealand ki store listing mein seedha likha hai: sex scenes.",
   "cap": "Australia aur New Zealand ki store listing mein seedha likha hai: sex scenes."
  },
  {
   "id": "s8",
   "group": "g7",
   "start": 27.071,
   "end": 34.916,
   "text": "Europe mein PEGI ne atharah plus ka label lagaya. Uski pehli summary website par thodi der dikhi, phir hata di gayi. Ab wahan ek chhoti, saadi summary hai.",
   "cap": "Europe mein PEGI ne atharah plus ka label lagaya. Uski pehli summary website par thodi der dikhi, phir hata di gayi. Ab wahan ek chhoti, saadi summary hai."
  },
  {
   "id": "s9",
   "group": "g8",
   "start": 35.591,
   "end": 38.249,
   "text": "Jo likha bataya gaya, use PEGI ne confirm nahi kiya.",
   "cap": "Jo likha bataya gaya, use PEGI ne confirm nahi kiya."
  },
  {
   "id": "s10",
   "group": "g9",
   "start": 38.81,
   "end": 43.267,
   "text": "Yaani ek hi game, alag-alag board, alag-alag shabd. Aur ek line mita di gayi.",
   "cap": "Yaani ek hi game, alag-alag board, alag-alag shabd. Aur ek line mita di gayi."
  },
  {
   "id": "s11",
   "group": "g10",
   "start": 43.848,
   "end": 46.048,
   "text": "Ek baat aur. Label chetavni hai, taala nahi.",
   "cap": "Ek baat aur. Label chetavni hai, taala nahi."
  },
  {
   "id": "s12",
   "group": "g11",
   "start": 46.583,
   "end": 51.797,
   "text": "Scenes ka poora byora ESRB ki summary mein hai. Hum use dohrate nahi. Label padhiye, afwahein nahi.",
   "cap": "Scenes ka poora byora ESRB ki summary mein hai. Hum use dohrate nahi. Label padhiye, afwahein nahi."
  },
  {
   "id": "s13",
   "group": "g12",
   "start": 52.363,
   "end": 56.745,
   "text": "Aisi baatein record se padhni hon, toh follow aur share kijiye, nerdlogic.co ko.",
   "cap": "Aisi baatein record se padhni hon, toh follow aur share kijiye, nerdlogic.co ko."
  }
 ],
