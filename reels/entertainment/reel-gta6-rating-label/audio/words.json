 "provisional": [],
 "B": {
  "s1": "जीटीए सिक्स में स्टीमी सीन हैं। ये अफ़वाह नहीं है।",
  "s2": "रेटिंग बोर्ड ने ख़ुद लिखा है।",
  "s3": "पहले अमेरिका। ई-एस-आर-बी का लेबल: एम, यानी मैच्योर, सत्रह प्लस।",
  "s4": "लेबल में सात चीज़ें लिखी हैं। मारधाड़, तेज़ हिंसा, गाली, नग्नता, मैच्योर ह्यूमर, नशा, और स्ट्रॉन्ग सेक्सुअल कंटेंट।",
  "s5": "सुनकर लगता है कि ये नया है। पर जीटीए फाइव के लेबल पर भी यही सात चीज़ें हैं।",
  "s6": "तो नया क्या है? शब्द।",
  "s7": "ऑस्ट्रेलिया और न्यूजीलैंड की स्टोर लिस्टिंग में सीधा लिखा है: सेक्स सीन।",
  "s8": "यूरोप में पेगी ने अठारह प्लस का लेबल लगाया। उसकी पहली समरी वेबसाइट पर थोड़ी देर दिखी, फिर हटा दी गई। अब वहाँ एक छोटी, सादी समरी है।",
  "s9": "जो लिखा बताया गया, उसे पेगी ने कन्फर्म नहीं किया।",
  "s10": "यानी एक ही गेम, अलग-अलग बोर्ड, अलग-अलग शब्द। और एक लाइन मिटा दी गई।",
  "s11": "एक बात और। लेबल चेतावनी है, ताला नहीं।",
  "s12": "सीन का पूरा ब्योरा ई-एस-आर-बी की समरी में है। हम उसे दोहराते नहीं। लेबल पढ़िए, अफवाहें नहीं।",
  "s13": "ऐसी बातें रिकॉर्ड से पढ़नी हों, तो फॉलो और शेयर कीजिए, नर्डलॉजिक डॉट सी ओ को।"
 }
