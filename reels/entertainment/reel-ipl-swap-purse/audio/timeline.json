{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 5.422,
   "text": "Hardik Pandya: ₹18 crore. Arshdeep Singh: ₹18 crore. Barabar paisa. Par kya sauda barabar hai?",
   "cap": "Hardik Pandya: ₹18 crore. Arshdeep Singh: ₹18 crore. Barabar paisa. Par kya sauda barabar hai?"
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 6.246,
   "end": 11.461,
   "text": "Gyaarah November ko Mumbai aur Punjab ne ek swap kiya. Hardik gaye Punjab, Arshdeep aaye Mumbai.",
   "cap": "Gyaarah November ko Mumbai aur Punjab ne ek swap kiya. Hardik gaye Punjab, Arshdeep aaye Mumbai."
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 12.012,
   "end": 17.109,
   "text": "Mumbai ko ye kyon karna pada? 2026 mein Mumbai, reports ke mutabik, nauwein number par rahi.",
   "cap": "Mumbai ko ye kyon karna pada? 2026 mein Mumbai, reports ke mutabik, nauwein number par rahi."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 17.915,
   "end": 22.26,
   "text": "Aur Bumrah ne poore season mein sirf chaar wicket liye, average ek sau do ke aaspaas.",
   "cap": "Aur Bumrah ne poore season mein sirf chaar wicket liye, average ek sau do ke aaspaas."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 22.767,
   "end": 28.851,
   "text": "To Mumbai ne Bumrah ka saathi dhoondha. Arshdeep Singh: Punjab ke liye sabse zyada wicket, ek sau gyaarah, chhiyaanbe match mein.",
   "cap": "To Mumbai ne Bumrah ka saathi dhoondha. Arshdeep Singh: Punjab ke liye sabse zyada wicket, ek sau gyaarah, chhiyaanbe match mein."
  },
  {
   "id": "s6",
   "group": "g6",
   "start": 29.437,
   "end": 35.186,
   "text": "Punjab ko kya mila? Hardik ki batting, aur ek nayi shuruaat, Shreyas Iyer aur Ricky Ponting ke saath.",
   "cap": "Punjab ko kya mila? Hardik ki batting, aur ek nayi shuruaat, Shreyas Iyer aur Ricky Ponting ke saath."
  },
  {
   "id": "s7",
   "group": "g7",
   "start": 35.647,
   "end": 40.336,
   "text": "Par pichhle season Hardik ne teis over mein sirf chaar wicket liye, economy lagbhag baarah.",
   "cap": "Par pichhle season Hardik ne teis over mein sirf chaar wicket liye, economy lagbhag baarah."
  },
  {
   "id": "s8",
   "group": "g8",
   "start": 41.096,
   "end": 47.955,
   "text": "Ab asli sawal paise ka hai. Satrah November ke baad Punjab ke paas sirf ₹18.6 crore bache, aur chhe jagah khaali.",
   "cap": "Ab asli sawal paise ka hai. Satrah November ke baad Punjab ke paas sirf ₹18.6 crore bache, aur chhe jagah khaali."
  },
  {
   "id": "s9",
   "group": "g9",
   "start": 48.494,
   "end": 51.213,
   "text": "Mumbai ke paas ₹32.6 crore, aur nau jagah.",
   "cap": "Mumbai ke paas ₹32.6 crore, aur nau jagah."
  },
  {
   "id": "s10",
   "group": "g10",
   "start": 51.781,
   "end": 57.224,
   "text": "Yaani Punjab ko ab bowling auction se khareedni padegi. Aur Aakash Chopra ke hisaab se, wahan ek bada gap hai.",
   "cap": "Yaani Punjab ko ab bowling auction se khareedni padegi. Aur Aakash Chopra ke hisaab se, wahan ek bada gap hai."
  },
  {
   "id": "s11",
   "group": "g11",
   "start": 57.917,
   "end": 61.544,
   "text": "Auction solah December ko Goa mein hai. Tabhi pata chalega, ye sauda kisne jeeta.",
   "cap": "Auction solah December ko Goa mein hai. Tabhi pata chalega, ye sauda kisne jeeta."
  },
  {
   "id": "s12",
   "group": "g12",
   "start": 62.325,
   "end": 67.207,
   "text": "IPL ka aisa hisaab-kitaab chahiye? nerdlogic.co ko follow karo, aur share karo.",
   "cap": "IPL ka aisa hisaab-kitaab chahiye? nerdlogic.co ko follow karo, aur share karo."
  },
  {
   "id": "s13",
   "group": "g13",
   "start": 67.936,
   "end": 71.982,
   "text": "Dono ₹18 crore ke. Par ek ko bowler mila, aur doosre ko bowling ka sawal.",
   "cap": "Dono ₹18 crore ke. Par ek ko bowler mila, aur doosre ko bowling ka sawal."
  }
 ],
