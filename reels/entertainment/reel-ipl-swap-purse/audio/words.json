 "B": {
  "s1": "हार्दिक पांड्या: अठारह करोड़। अर्शदीप सिंह: अठारह करोड़। बराबर पैसा। पर क्या सौदा बराबर है?",
  "s2": "ग्यारह नवंबर को मुंबई और पंजाब ने एक स्वैप किया। हार्दिक गए पंजाब, अर्शदीप आए मुंबई।",
  "s3": "मुंबई को ये क्यों करना पड़ा? दो हज़ार छब्बीस में मुंबई, रिपोर्ट्स के मुताबिक़, नौवें नंबर पर रही।",
  "s4": "और बुमराह ने पूरे सीज़न में सिर्फ़ चार विकेट लिए, औसत एक सौ दो के आसपास।",
  "s5": "तो मुंबई ने बुमराह का साथी ढूँढा। अर्शदीप सिंह: पंजाब के लिए सबसे ज़्यादा विकेट, एक सौ ग्यारह, छियानबे मैच में।",
  "s6": "पंजाब को क्या मिला? हार्दिक की बल्लेबाज़ी, और एक नई शुरुआत, श्रेयस अय्यर और रिकी पोंटिंग के साथ।",
  "s7": "पर पिछले सीज़न हार्दिक ने तेईस ओवर में सिर्फ़ चार विकेट लिए, इकॉनमी लगभग बारह।",
  "s8": "अब असली सवाल पैसे का है। सत्रह नवंबर के बाद पंजाब के पास सिर्फ़ अठारह पॉइंट छह करोड़ बचे, और छह जगह खाली।",
  "s9": "मुंबई के पास बत्तीस पॉइंट छह करोड़, और नौ जगह।",
  "s10": "यानी पंजाब को अब बॉलिंग नीलामी से ख़रीदनी पड़ेगी। और आकाश चोपड़ा के हिसाब से, वहाँ एक बड़ा गैप है।",
  "s11": "नीलामी सोलह दिसंबर को गोवा में है। तभी पता चलेगा, ये सौदा किसने जीता।",
  "s12": "आईपीएल का ऐसा हिसाब-किताब चाहिए? नर्डलॉजिक डॉट सी ओ को फ़ॉलो करो, और शेयर करो।",
  "s13": "दोनों अठारह करोड़ के। पर एक को बॉलर मिला, और दूसरे को बॉलिंग का सवाल।"
 }
}