{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 10.698,
   "text": "Chandrayaan-3 chaand tak 615 crore mein pahuncha. Ramayana Part 1 ka budget, reports ke mutabik, 835 se 900 crore. Chaand par jaana sasta, aur chamatkar dikhana mehnga? Aisa kyun?",
   "cap": "Chandrayaan-3 chaand tak 615 crore mein pahuncha. Ramayana Part 1 ka budget, reports ke mutabik, 835 se 900 crore. Chaand par jaana sasta, aur chamatkar dikhana mehnga? Aisa kyun?"
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 11.352,
   "end": 17.193,
   "text": "Asli duniya mein sooraj ki kiran muft hai. Deewar par girti hai, aur bas chali jaati hai. Kisi ko hisaab nahi lagta.",
   "cap": "Asli duniya mein sooraj ki kiran muft hai. Deewar par girti hai, aur bas chali jaati hai. Kisi ko hisaab nahi lagta."
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 17.867,
   "end": 26.695,
   "text": "Parde par kuch bhi pehle se maujood nahi hota. Har kiran ke liye computer ko poochna padta hai: ye kahan girti hai? Kahan mudti hai? Kahan rukti hai? Isi sawaal ka bill lagta hai.",
   "cap": "Parde par kuch bhi pehle se maujood nahi hota. Har kiran ke liye computer ko poochna padta hai: ye kahan girti hai? Kahan mudti hai? Kahan rukti hai? Isi sawaal ka bill lagta hai."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 27.568,
   "end": 34.071,
   "text": "Is film ke producer Namit Malhotra ki company DNEG ye bill pehle bhi bhar chuki hai. Interstellar ka black hole yaad hai?",
   "cap": "Is film ke producer Namit Malhotra ki company DNEG ye bill pehle bhi bhar chuki hai. Interstellar ka black hole yaad hai?"
  },
  {
   "id": "s4b",
   "group": "g5",
   "start": 34.537,
   "end": 38.32,
   "text": "Reports ke mutabik kuch frame ek-ek ke liye sau ghante tak render hue.",
   "cap": "Reports ke mutabik kuch frame ek-ek ke liye sau ghante tak render hue."
  },
  {
   "id": "s5",
   "group": "g6",
   "start": 38.876,
   "end": 43.938,
   "text": "Aur us kaam par do asli science paper chhape. Yaani wahan roshni ka khel physics ka tha, jaadu ka nahi.",
   "cap": "Aur us kaam par do asli science paper chhape. Yaani wahan roshni ka khel physics ka tha, jaadu ka nahi."
  },
  {
   "id": "s6",
   "group": "g7",
   "start": 44.538,
   "end": 51.462,
   "text": "Ab Ramayana ki taraf. Cinematographer Pankaj Kumar ke mutabik, motion capture floor par qareeb 42 infrared camera the.",
   "cap": "Ab Ramayana ki taraf. Cinematographer Pankaj Kumar ke mutabik, motion capture floor par qareeb 42 infrared camera the."
  },
  {
   "id": "s7",
   "group": "g8",
   "start": 51.965,
   "end": 56.393,
   "text": "Kumbhakarna, Hanuman, asur: jahan asli abhineta nahi, wahan unki chaal capture ki gayi.",
   "cap": "Kumbhakarna, Hanuman, asur: jahan asli abhineta nahi, wahan unki chaal capture ki gayi."
  },
  {
   "id": "s8",
   "group": "g9",
   "start": 56.985,
   "end": 63.276,
   "text": "Aur Jatayu? Unke shabdon mein, Jatayu poori tarah CG hai. Us scene mein sirf do asli abhineta the: Yash aur Sai Pallavi.",
   "cap": "Aur Jatayu? Unke shabdon mein, Jatayu poori tarah CG hai. Us scene mein sirf do asli abhineta the: Yash aur Sai Pallavi."
  },
  {
   "id": "s9",
   "group": "g10",
   "start": 63.932,
   "end": 67.33,
   "text": "Yaani har pankh, har chhaya, un par padti har kiran ganit se aayi.",
   "cap": "Yaani har pankh, har chhaya, un par padti har kiran ganit se aayi."
  },
  {
   "id": "s10",
   "group": "g11",
   "start": 68.155,
   "end": 73.02,
   "text": "Poora bill kitna? Ye abhi kisi ne nahi bataya. Render ke ghante aur bijli ka kharcha public nahi hai.",
   "cap": "Poora bill kitna? Ye abhi kisi ne nahi bataya. Render ke ghante aur bijli ka kharcha public nahi hai."
  },
  {
   "id": "s10b",
   "group": "g12",
   "start": 73.56,
   "end": 81.518,
   "text": "Budget ke aankde bhi alag-alag hain: Part 1 ke liye 835 se 900 crore, aur do hisson ka milakar, makers ke mutabik, 4,000 crore.",
   "cap": "Budget ke aankde bhi alag-alag hain: Part 1 ke liye 835 se 900 crore, aur do hisson ka milakar, makers ke mutabik, 4,000 crore."
  },
  {
   "id": "s11",
   "group": "g13",
   "start": 82.179,
   "end": 85.922,
   "text": "Ye tulna adhoori hai, ek mission ki aur ek film ki. Par sawaal asli hai.",
   "cap": "Ye tulna adhoori hai, ek mission ki aur ek film ki. Par sawaal asli hai."
  },
  {
   "id": "s11b",
   "group": "g14",
   "start": 86.49,
   "end": 91.231,
   "text": "Jab agli baar parde par roshni ki ek kiran dikhe, yaad rakhna: asli duniya mein wo muft thi.",
   "cap": "Jab agli baar parde par roshni ki ek kiran dikhe, yaad rakhna: asli duniya mein wo muft thi."
  },
  {
   "id": "s12",
   "group": "g15",
   "start": 92.172,
   "end": 96.3,
   "text": "Aisi aur kahaniyan chahiye? nerdlogic.co ko follow karo, aur share karo.",
   "cap": "Aisi aur kahaniyan chahiye? nerdlogic.co ko follow karo, aur share karo."
  }
 ],
