 "provisional": [],
 "B": {
  "s1": "चंद्रयान-तीन चाँद तक छह सौ पंद्रह करोड़ में पहुँचा। रामायण पार्ट वन का बजट, रिपोर्ट्स के मुताबिक़, आठ सौ पैंतीस से नौ सौ करोड़। चाँद पर जाना सस्ता, और चमत्कार दिखाना महँगा? ऐसा क्यों?",
  "s2": "असली दुनिया में सूरज की किरण मुफ़्त है। दीवार पर गिरती है, और बस चली जाती है। किसी को हिसाब नहीं लगता।",
  "s3": "पर्दे पर कुछ भी पहले से मौजूद नहीं होता। हर किरण के लिए कंप्यूटर को पूछना पड़ता है: ये कहाँ गिरती है? कहाँ मुड़ती है? कहाँ रुकती है? इसी सवाल का बिल लगता है।",
  "s4": "इस फ़िल्म के प्रोड्यूसर नमित मल्होत्रा की कंपनी डी-नेग ये बिल पहले भी भर चुकी है। इंटरस्टेलर का ब्लैक होल याद है?",
  "s4b": "रिपोर्ट्स के मुताबिक़ कुछ फ्रेम एक-एक के लिए सौ घंटे तक रेंडर हुए।",
  "s5": "और उस काम पर दो असली साइंस पेपर छपे। यानी वहाँ रोशनी का खेल फ़िज़िक्स का था, जादू का नहीं।",
  "s6": "अब रामायण की तरफ़। सिनेमैटोग्राफ़र पंकज कुमार के मुताबिक़, मोशन कैप्चर फ़्लोर पर क़रीब बयालीस इन्फ़्रारेड कैमरे थे।",
  "s7": "कुंभकर्ण, हनुमान, असुर: जहाँ असली अभिनेता नहीं, वहाँ उनकी चाल कैप्चर की गई।",
  "s8": "और जटायु? उनके शब्दों में, जटायु पूरी तरह सी-जी है। उस सीन में सिर्फ़ दो असली अभिनेता थे: यश और साई पल्लवी।",
  "s9": "यानी हर पंख, हर छाया, उन पर पड़ती हर किरण गणित से आई।",
  "s10": "पूरा बिल कितना? ये अभी किसी ने नहीं बताया। रेंडर के घंटे और बिजली का ख़र्चा पब्लिक नहीं है।",
  "s10b": "बजट के आँकड़े भी अलग-अलग हैं: पार्ट वन के लिए आठ सौ पैंतीस से नौ सौ करोड़, और दो हिस्सों का मिलाकर, मेकर्स के मुताबिक़, चार हज़ार करोड़।",
  "s11": "ये तुलना अधूरी है, एक मिशन की और एक फ़िल्म की। पर सवाल असली है।",
  "s11b": "जब अगली बार पर्दे पर रोशनी की एक किरण दिखे, याद रखना: असली दुनिया में वो मुफ़्त थी।",
  "s12": "ऐसी और कहानियाँ चाहिए? नर्डलॉजिक डॉट सी ओ को फ़ॉलो करो, और शेयर करो।"
 }
}