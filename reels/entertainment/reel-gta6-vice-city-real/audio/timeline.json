{
 "sentences": [
  {
   "id": "s1",
   "group": "g1",
   "start": 0.0,
   "end": 8.949,
   "text": "Aaj GTA 6 aa gaya hai. Duniya bhar ke log ek nakli shehar mein utrenge. Par wo shehar ek asli jagah se bana hai, aur us jagah ki sabse mashhoor kahani khud nakli hai.",
   "cap": "Aaj GTA 6 aa gaya hai. Duniya bhar ke log ek nakli shehar mein utrenge. Par wo shehar ek asli jagah se bana hai, aur us jagah ki sabse mashhoor kahani khud nakli hai."
  },
  {
   "id": "s2",
   "group": "g2",
   "start": 9.529,
   "end": 18.613,
   "text": "Pichla GTA 5 baais crore se zyada bika. Aur Take-Two ke mutabik, GTA 6 ke doosre trailer ko chaubees ghante mein saintaalis crore se zyada views mile, saare platform milakar.",
   "cap": "Pichla GTA 5 baais crore se zyada bika. Aur Take-Two ke mutabik, GTA 6 ke doosre trailer ko chaubees ghante mein saintaalis crore se zyada views mile, saare platform milakar."
  },
  {
   "id": "s3",
   "group": "g3",
   "start": 19.193,
   "end": 32.174,
   "text": "Ab asli jagah dekho: America ka Miami. September mein wahan ek arena ki chhat par, helicopter se ek board utaara gaya: Welcome to Vice City. Report ke mutabik qareeb saade nau lakh dollar ka sauda, aur board par game ka poora naam likhna mana hai.",
   "cap": "Ab asli jagah dekho: America ka Miami. September mein wahan ek arena ki chhat par, helicopter se ek board utaara gaya: Welcome to Vice City. Report ke mutabik qareeb saade nau lakh dollar ka sauda, aur board par game ka poora naam likhna mana hai."
  },
  {
   "id": "s4",
   "group": "g4",
   "start": 32.697,
   "end": 40.54,
   "text": "Game ki duniya ka naam hai Leonida, aur wo Florida jaisi hai. Vice City Miami hai, Leonida Keys Florida Keys, aur Grassrivers Everglades ka daldal.",
   "cap": "Game ki duniya ka naam hai Leonida, aur wo Florida jaisi hai. Vice City Miami hai, Leonida Keys Florida Keys, aur Grassrivers Everglades ka daldal."
  },
  {
   "id": "s5",
   "group": "g5",
   "start": 41.105,
   "end": 50.647,
   "text": "Aur us daldal ki sabse asli cheez: magarmachh. Florida ki wildlife agency ke mutabik wahan qareeb terah lakh alligator hain, aur wo sadsath ke sadsath zilon mein milte hain.",
   "cap": "Aur us daldal ki sabse asli cheez: magarmachh. Florida ki wildlife agency ke mutabik wahan qareeb terah lakh alligator hain, aur wo sadsath ke sadsath zilon mein milte hain."
  },
  {
   "id": "s6",
   "group": "g6",
   "start": 51.085,
   "end": 61.149,
   "text": "Ab asli jagah ki sabse mashhoor kahani. Kehte hain, Spain ka khoji Ponce de Leon, jawaani ka jharna dhoondhte hue Florida pahuncha tha. Par uske apne kaagzon mein aise kisi jharne ka zikr hi nahin hai.",
   "cap": "Ab asli jagah ki sabse mashhoor kahani. Kehte hain, Spain ka khoji Ponce de Leon, jawaani ka jharna dhoondhte hue Florida pahuncha tha. Par uske apne kaagzon mein aise kisi jharne ka zikr hi nahin hai."
  },
  {
   "id": "s7",
   "group": "g7",
   "start": 61.714,
   "end": 67.137,
   "text": "Jharne wali kahani pehli baar uski maut ke chaudah saal baad likhi gayi. Itihaaskaar ise mithak maante hain.",
   "cap": "Jharne wali kahani pehli baar uski maut ke chaudah saal baad likhi gayi. Itihaaskaar ise mithak maante hain."
  },
  {
   "id": "s8",
   "group": "g8",
   "start": 67.847,
   "end": 72.827,
   "text": "Toh nakli shehar, asli jagah se bana. Aur us asli jagah ki sabse badi kahani, nakli nikli.",
   "cap": "Toh nakli shehar, asli jagah se bana. Aur us asli jagah ki sabse badi kahani, nakli nikli."
  },
  {
   "id": "s9",
   "group": "g9",
   "start": 73.493,
   "end": 85.369,
   "text": "GTA 6 aaj sirf PS5 aur Xbox Series par hai. PC ki koi taareekh nahin batayi gayi. Bharat mein PS5 par keemat report ke mutabik paanch hazaar nau sau ninyaanve rupaye, par khareedne se pehle PlayStation Store par dekh lena.",
   "cap": "GTA 6 aaj sirf PS5 aur Xbox Series par hai. PC ki koi taareekh nahin batayi gayi. Bharat mein PS5 par keemat report ke mutabik paanch hazaar nau sau ninyaanve rupaye, par khareedne se pehle PlayStation Store par dekh lena."
  },
  {
   "id": "s10",
   "group": "g10",
   "start": 85.886,
   "end": 89.655,
   "text": "Aisi aur kahaniyon ke liye, follow aur share kariye, nerdlogic.co ko.",
   "cap": "Aisi aur kahaniyon ke liye, follow aur share kariye, nerdlogic.co ko."
  }
