{
  "name": "yt16x9-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Automated 16:9 long-form YouTube video pipeline: research -> packaging -> script -> assets -> normalize/mix -> Remotion render -> QA -> publish -> learn. Bun runtime throughout. See BUILD_PLAN.md before writing any stage.",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "remotion:studio": "remotion studio src/stages/h-render/index.ts",
    "remotion:still": "remotion still src/stages/h-render/index.ts",
    "remotion:render": "remotion render src/stages/h-render/index.ts MasterVideo",
    "remotion:benchmark": "remotion benchmark src/stages/h-render/index.ts",
    "normalize": "bun src/stages/e-normalize-mix/normalize.ts",
    "pipeline:dev": "bun src/orchestration/dev-runner.ts",
    "inngest:dev": "bunx inngest-cli@latest dev"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "googleapis": "^144.0.0",
    "inngest": "^3.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "4.0.529",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.6.0"
  }
}
